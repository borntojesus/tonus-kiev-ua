{"id":8057,"date":"2020-11-15T13:29:37","date_gmt":"2020-11-15T10:29:37","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8057"},"modified":"2020-11-15T13:29:37","modified_gmt":"2020-11-15T10:29:37","slug":"kompulsivnoe-povedenie","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/kompulsivnoe-povedenie\/","title":{"rendered":"\u041a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435"},"content":{"rendered":"<blockquote><p><em><span style=\"font-size: 12pt;\">\u041a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 &#8212; \u044d\u0442\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0439, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f. \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f &#8212; \u044d\u0442\u043e \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0443\u0445\u043e\u0434\u0430 \u043e\u0442 \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u0445 \u043c\u044b\u0441\u043b\u0435\u0439 \u0438\u043b\u0438 \u0438\u0434\u0435\u0439.<\/span><\/em><\/p><\/blockquote>\n<h2><span style=\"font-size: 14pt;\">\u0412\u0438\u0434\u044b \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f:<\/span><\/h2>\n<ol>\n<li><strong><span style=\"color: #003366;\">\u0421\u043f\u043e\u0440\u0442<\/span><\/strong>. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u043e\u0440\u0442\u043e\u043c 6-7 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u043f\u043e 3-5 \u0447\u0430\u0441\u043e\u0432.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0415\u0434\u0430<\/strong><\/span>. \u041d\u0435\u0443\u043c\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u043c\u043e\u0439 \u043f\u0438\u0449\u0438. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0435\u0434\u0430\u043d\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u044f \u0438 \u043b\u0438\u0448\u043d\u0435\u0433\u043e \u0432\u0435\u0441\u0430.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u0435\u043a\u0441<\/strong><\/span>. \u041d\u0438\u043c\u0444\u043e\u043c\u0430\u043d\u0438\u044f. \u0427\u0443\u0432\u0441\u0442\u0432\u0430, \u043c\u044b\u0441\u043b\u0438 \u0438 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 &#8212; \u044d\u0442\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0432\u0435\u0434\u0451\u0442 \u0431\u0435\u0441\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0432\u044b\u0435 \u0441\u0432\u044f\u0437\u0438.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0428\u043e\u043f\u043f\u0438\u043d\u0433<\/strong><\/span>. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0442\u0440\u0430\u0442\u0438\u0442 \u0432\u0441\u0435 \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0443 \u043d\u043e\u0432\u044b\u0445 \u0432\u0435\u0449\u0435\u0439, \u0445\u043e\u0442\u044f \u0432 \u043d\u0438\u0445 \u043d\u0435\u0442 \u043d\u0443\u0436\u0434\u044b. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f: \u0442\u0440\u0430\u0442\u044b \u0432\u0441\u0435\u0445 \u0434\u0435\u043d\u0435\u0433 \u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0410\u0437\u0430\u0440\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u044b<\/strong><\/span>. \u0416\u0435\u043b\u0430\u043d\u0438\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u044b: \u0441\u0442\u0430\u0432\u043a\u0438 \u0432 \u0431\u0443\u043a\u043c\u0435\u043a\u0435\u0440\u0441\u043a\u0438\u0445 \u043a\u043e\u043d\u0442\u043e\u0440\u0430\u0445, \u043f\u043e\u043a\u0435\u0440, \u0438\u0433\u0440\u043e\u0432\u044b\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b \u0438 \u0434\u0440. \u0421\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f. \u0412 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0445 \u0438\u0433\u0440\u0430\u0445 \u043b\u044e\u0434\u0438 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u044e\u0442 \u0446\u0435\u043b\u044b\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f. \u0412\u0435\u0434\u0451\u0442 \u043a \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438, \u0434\u043e\u043b\u0433\u0430\u043c, \u043a\u0440\u0435\u0434\u0438\u0442\u0430\u043c.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0435 \u0438\u0433\u0440\u044b<\/strong><\/span>. \u0427\u0430\u0441\u0442\u043e \u044d\u0442\u0438\u043c \u0432\u0438\u0434\u043e\u043c \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0442 \u043c\u0443\u0436\u0447\u0438\u043d\u044b. \u041a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u0438\u0433\u0440\u044b, \u0442\u043e \u0443\u0445\u043e\u0434\u044f\u0442 \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u0440 \u0441 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438. \u041f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0438<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0412\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f<\/strong><\/span>. \u0412\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u043e\u0442 \u043a\u0430\u043a\u0438\u0445 \u043b\u0438\u0431\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438\u043b\u0438 \u043c\u044b\u0441\u043b\u0435\u0439.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u042d\u043a\u0441\u0442\u0440\u0438\u043c<\/strong><\/span>. \u042d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u0438\u0434\u044b \u0441\u043f\u043e\u0440\u0442\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0435 \u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e \u0438 \u0436\u0438\u0437\u043d\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.<\/li>\n<\/ol>\n<p>\u041e\u0431\u0441\u0435\u0441\u0438\u0432\u043d\u043e-\u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043a\u043e\u0440\u043d\u0435\u043c \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0432 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u043c \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u0442\u0440\u0430\u0434\u0430\u0435\u0442 \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u043c\u0438 \u043c\u044b\u0441\u043b\u044f\u043c\u0438 \u0438 \u0438\u0434\u0435\u044f\u043c\u0438 \u0438 \u044d\u0442\u043e \u0442\u043e\u043b\u043a\u0430\u0435\u0442 \u0435\u0433\u043e \u043d\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0435\u043c\u0443 \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u043d\u0438\u0445. \u0423 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043b\u044e\u0434\u0435\u0439 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044e \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f, \u0430 \u043b\u0438\u0448\u044c \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0441\u0442\u0440\u0435\u0441\u0441\u0430. \u041d\u043e, \u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u043b\u044e\u0434\u0435\u0439 \u0432\u0441\u0435 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442.<\/p>\n<p>\u041f\u043e\u0441\u043b\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0442\u0435\u0440\u044f\u0435\u0442 &#171;\u0432\u043a\u0443\u0441&#187; \u043a \u0436\u0438\u0437\u043d\u0438. <a href=\"https:\/\/tonus.kiev.ua\/lomka-ili-sindrom-otmeny\/\" target=\"_blank\" rel=\"noopener noreferrer\">\u0410\u0431\u0441\u0442\u0438\u043d\u0435\u043d\u0442\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c<\/a> \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043c\u0440\u0430\u0447\u043d\u043e\u0439 \u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u0435\u043c\u0443 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0440\u0430\u0434\u043e\u0441\u0442\u0438 \u0438 \u0441\u0447\u0430\u0441\u0442\u044c\u044f.<\/p>\n<p>\u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438 \u0438 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u044c\u0441\u044f \u043a \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438, \u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u0432 \u043c\u043e\u0437\u0433\u0443 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u043a\u0430 <a href=\"https:\/\/ru.wikipedia.org\/wiki\/%D0%94%D0%BE%D1%84%D0%B0%D0%BC%D0%B8%D0%BD\" target=\"_blank\" rel=\"noopener noreferrer\">\u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430<\/a> \u0438 <a href=\"https:\/\/ru.wikipedia.org\/wiki\/%D0%A1%D0%B5%D1%80%D0%BE%D1%82%D0%BE%D0%BD%D0%B8%D0%BD\" target=\"_blank\" rel=\"noopener noreferrer\">\u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430<\/a>. \u042d\u0442\u043e \u043d\u0435\u0439\u0440\u043e\u043c\u0435\u0434\u0438\u0430\u0442\u043e\u0440\u044b \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f \u0438 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f. \u0418 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0446\u0435\u043f\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u0430 \u044d\u0442\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0435 &#171;\u0441\u0447\u0430\u0441\u0442\u044c\u0435&#187; \u0438 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u044d\u0442\u043e\u0442 \u0440\u043e\u0434 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0441 \u0433\u043e\u043b\u043e\u0432\u043e\u0439, \u0437\u0430\u0431\u044b\u0432\u0430\u044f \u043f\u0440\u043e \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0441\u0444\u0435\u0440\u044b \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u042d\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0442 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438. \u0414\u043b\u044f \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u0431\u0430\u043b\u0430\u043d\u0441 \u0432\u043e \u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445, \u0430 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043b\u0438\u0448\u0430\u0435\u0442 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u0435\u0431\u044f \u0432\u043e \u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445.<\/p>\n<p>\u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0441\u0440\u044b\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430. \u0415\u0441\u043b\u0438 \u0432\u043e\u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0442\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0443\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u043e\u0442 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u044f, \u0430 \u044d\u0442\u043e \u043d\u0438 \u043a \u0447\u0435\u043c\u0443 \u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443 \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442.<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u041a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 &#8212; \u044d\u0442\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0439, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f. \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f &#8212; \u044d\u0442\u043e \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0443\u0445\u043e\u0434\u0430 \u043e\u0442 \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u0445 \u043c\u044b\u0441\u043b\u0435\u0439 \u0438\u043b\u0438 \u0438\u0434\u0435\u0439. \u0412\u0438\u0434\u044b \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f: \u0421\u043f\u043e\u0440\u0442. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u043e\u0440\u0442\u043e\u043c 6-7 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u043f\u043e 3-5 \u0447\u