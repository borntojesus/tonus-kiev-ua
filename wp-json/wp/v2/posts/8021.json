{"id":8021,"date":"2020-10-11T15:37:02","date_gmt":"2020-10-11T12:37:02","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8021"},"modified":"2020-10-11T15:42:12","modified_gmt":"2020-10-11T12:42:12","slug":"posledstvija-ot-narkotikov","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/posledstvija-ot-narkotikov\/","title":{"rendered":"\u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432"},"content":{"rendered":"<blockquote><p><em>\u041d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u044f \u2013 \u044d\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u044e\u0449\u0435\u0433\u043e \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438, \u0430 \u0438 \u043d\u0430 \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043e\u0437\u044b \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043b\u043e\u043c\u043a\u0435, \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0442\u044f\u0436\u0451\u043b\u0443\u044e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e, \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044c \u043a \u0441\u0443\u0438\u0446\u0438\u0434\u0443.<\/em><\/p><\/blockquote>\n<p>\u0423\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0433\u0443\u0431\u0438\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043b\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043d\u043e \u0438 \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u0438\u043a\u0443. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043b\u0451\u0433\u043a\u0438\u0435, \u043d\u043e \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u043e\u0447\u0435\u043d\u044c \u0442\u044f\u0436\u0451\u043b\u044b\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b.<\/p>\n<p>\u041d\u0430 \u043f\u0435\u0440\u0432\u044b\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u043f\u0440\u0438\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043a \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430\u043c \u0443 \u043b\u044e\u0434\u0435\u0439 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445, \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044c \u043a \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u043d\u0435\u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u043c \u0440\u0435\u0430\u043a\u0446\u0438\u044f\u043c \u043d\u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. \u0421 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u043f\u043e\u0445\u043e\u0436\u0438\u043c\u0438 \u0434\u0440\u0443\u0433 \u043d\u0430 \u0434\u0440\u0443\u0433\u0430 \u0441\u0432\u043e\u0438\u043c \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435\u043c.<\/p>\n<p><img class=\"lazy lazy-hidden aligncenter size-full wp-image-8023\" src=\"data:image\/svg+xml,%3Csvg xmlns=%22http:\/\/www.w3.org\/2000\/svg%22 viewBox=%220 0 480 270%22%3E%3C\/svg%3E\" data-lazy-type=\"image\" data-src=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov.jpg\" alt=\"\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043e\u0442 \u043f\u0440\u0438\u0435\u043c\u0430 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432\" width=\"480\" height=\"270\" srcset=\"\" data-srcset=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov.jpg 480w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov-300x169.jpg 300w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov-151x85.jpg 151w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov-242x136.jpg 242w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/posledstvija-priema-narkotikov-80x45.jpg 80w\" sizes=\"(max-width: 480px) 100vw, 480px\" \/><\/p>\n<p>\u0423 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u043e\u0432 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0435\u0435\u0441\u044f \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e, \u043b\u0436\u0438\u0432\u043e\u0441\u0442\u044c\u044e, \u043f\u043e\u0442\u0435\u0440\u0435\u0439 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0434\u043e\u043b\u0433\u0430 \u0438 \u0441\u0430\u043c\u043e\u043a\u0440\u0438\u0442\u0438\u043a\u0438. \u0423 \u043d\u0438\u0445 \u0438\u0441\u043a\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043e\u0446\u0435\u043d\u043a\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043e\u043d\u0438 \u0434\u0443\u043c\u0430\u044e\u0442 \u0447\u0442\u043e \u0443 \u043d\u0438\u0445 \u0432\u0441\u0451 \u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c. \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u044f \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u0441\u0435 \u043c\u044b\u0441\u043b\u0438 \u0438 \u0441\u0438\u043b\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u044b \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438 \u2013 \u0434\u043e\u0431\u044b\u0442\u044c \u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u044c \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043e.<\/p>\n<p>\u0421\u0430\u043c\u044b\u043c\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0434\u043b\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f:<\/p>\n<ul style=\"list-style-type: square;\">\n<li><span style=\"color: #003366;\"><strong>\u0413\u0435\u043f\u0430\u0442\u0438\u0442, \u0412\u0418\u0427;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0437\u0443\u0431\u043e\u0432;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u041f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u041e\u0442\u043a\u0430\u0437 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0435\u0447\u0435\u043d\u0438;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.<\/strong><\/span><\/li>\n<\/ul>\n<p>\u041f\u043e\u0447\u0442\u0438 \u0443 \u0432\u0441\u0435\u0445 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u043e\u0432 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u0435\u0447\u0435\u043d\u044c\u044e, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439, \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e\u0439, \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u043e\u0439 \u0438 \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c. \u0421\u0442\u043e\u0438\u0442 \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u0447\u0442\u043e \u0438\u0437-\u0437\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0443 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u043e\u0432 \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0442\u044c \u0438\u0437-\u0437\u0430 \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u0441\u0443\u0438\u0446\u0438\u0434\u043e\u0432, \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430\u0445, \u0442\u0440\u0430\u0432\u043c \u0438 \u043d\u0430\u0441\u0438\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u0421\u0440\u0435\u0434\u043d\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 35-37 \u043b\u0435\u0442.<\/p>\n<p>\u0412 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0444\u0435\u0440\u0435 \u0436\u0438\u0437\u043d\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430 \u0436\u0434\u0451\u0442 \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u0440\u0430\u0445. \u0421\u0435\u043c\u044c\u044f \u043e\u0442 \u043d\u0435\u0433\u043e \u043e\u0442\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u0434\u0440\u0443\u0437\u044c\u044f \u0443\u0445\u043e\u0434\u044f\u0442, \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u0431\u0440\u043e\u0441\u0430\u0435\u0442, \u0441 \u0440\u0430\u0431\u043e\u0442\u044b \u0443\u0432\u043e\u043b\u044c\u043d\u044f\u044e\u0442.<\/p>\n<p>\u0422\u043e, \u0447\u0442\u043e \u0434\u0430\u0451\u0442 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a \u0437\u0430\u043c\u0435\u043d\u0438\u0442 \u0435\u043c\u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u0440, \u043d\u043e \u043d\u0435 \u043d\u0430 \u0434\u043e\u043b\u0433\u043e, \u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043c\u0438\u0440\u0435 \u0435\u0433\u043e \u0436\u0434\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043a\u043e\u0448\u043c\u0430\u0440 \u2013 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438, \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u043b\u043e\u043c\u043a\u0438, \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u0433\u043d\u0438\u044e\u0449\u0438\u0435 \u0437\u0443\u0431\u044b, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u0438\u043c\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u044f. \u0412\u0441\u0435 \u0442\u0435\u043b\u043e \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0433\u043d\u0438\u0442\u044c \u043e\u0442 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432. \u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0430\u043c\u0438 \u0438\u043b\u0438 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0435\u043c \u043e\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u0432 \u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440 &#171;\u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441&#187; \u043c\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u044b \u043f\u043e\u043c\u043e\u0447\u044c<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u041d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u044f \u2013 \u044d\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u044e\u0449\u0435\u0433\u043e \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438, \u0430 \u0438 \u043d\u0430 \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043e\u0437\u044b \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043b\u043e\u043c\u043a\u0435, \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0442\u044f\u0436\u0451\u043b\u0443\u044e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e, \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044c \u043a \u0441\u0443\u0438\u0446\u0438\u0434\u0443. \u0423\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0433\u0443\u0431\u0438\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043b\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043d\u043e \u0438 \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u0438\u043a\u0443. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043b\u0451\u0433\u043a\u0438\u0435, \u043d\u043e \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u043e\u0447\u0435\u043d\u044c \u0442\u044f\u0436\u0451\u043b\u044b\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435&#8230;<\/p>\n","protected":false},"author":1,"featured_media":8022,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":[],"categories":[1],"tags":[],"yst_prominent_words":[2065,2066,300,507,272,1586,1888,326,34,695,2067,1868,2064,225],"_links":{"self":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/