{"id":8031,"date":"2020-10-25T15:53:37","date_gmt":"2020-10-25T12:53:37","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8031"},"modified":"2020-10-25T15:53:37","modified_gmt":"2020-10-25T12:53:37","slug":"tipy-narkoticheskih-zavisimostej","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/tipy-narkoticheskih-zavisimostej\/","title":{"rendered":"\u0422\u0438\u043f\u044b \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0435\u0439"},"content":{"rendered":"<blockquote><p><em><span style=\"font-size: 12pt;\">\u0417\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0430\u0432\u043d\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u0438 \u0434\u043e \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u043f\u043e\u0440 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u043b \u0447\u0442\u043e \u0441 \u043d\u0435\u0439 \u0434\u0435\u043b\u0430\u0442\u044c. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0447\u0451\u043d\u044b\u0445, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e\u0432 \u0438 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u043e\u0432 \u0434\u0430\u044e\u0442 \u043d\u0430\u043c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.<\/span><\/em><\/p><\/blockquote>\n<p>\u042d\u0442\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0432\u0430\u0436\u043d\u044b\u043c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438: \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0431\u043e\u043b\u0435\u0437\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0438 \u043d\u0430 \u043c\u043e\u0437\u0433 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e.<\/p>\n<p><strong>\u041a\u0430\u043a \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442?<\/strong><br \/>\n&#8212; \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u043e\u0434\u043d\u0443 \u0434\u043e\u0437\u0443 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0430, \u043e\u043d \u043f\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u043d\u0430 \u0435\u0433\u043e \u043c\u043e\u0437\u0433, \u0432\u044b\u0437\u0432\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u0438\u0437\u0430\u0446\u0438\u044e \u043d\u0435\u0439\u0440\u043e\u043c\u0435\u0434\u0438\u0430\u0442\u043e\u0440\u043e\u0432 \u0432 \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u044b\u0445 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f\u0445. \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u044d\u0439\u0444\u043e\u0440\u0438\u044e \u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435. \u0417\u0430\u043f\u043e\u043c\u043d\u0438\u043b \u044d\u0442\u043e \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435. \u0427\u0435\u0440\u0435\u0437 \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u0437\u0430\u0445\u043e\u0442\u0435\u043b \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438\u0441\u043f\u044b\u0442\u0430\u0442\u044c \u043a\u0430\u0439\u0444. \u041f\u043e\u0442\u043e\u043c \u0435\u0449\u0451 \u0440\u0430\u0437, \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u0435\u0449\u0451. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0439 \u0446\u0438\u043a\u043b \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u0447\u0435\u043d\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0439\u0442\u0438.<\/p>\n<h2><span style=\"font-size: 14pt;\">\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0430 \u0442\u0438\u043f\u0430 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438:<\/span><\/h2>\n<ol>\n<li><strong>\u0425\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c.<\/strong>\u00a0\u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u043c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0441 \u0446\u0435\u043b\u044c\u044e \u0443\u0445\u043e\u0434\u0430 \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0430\u0435\u043c\u044b\u0445 \u0447\u0443\u0432\u0441\u0442\u0432 \u0438 \u044d\u043c\u043e\u0446\u0438\u0439.<\/li>\n<li><strong>\u041d\u0435 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c.<\/strong> \u0427\u0430\u0441\u0442\u043e \u0435\u0449\u0451 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c. \u042d\u0442\u043e \u0432\u0438\u0434 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u0442\u043d\u043e\u0441\u044f\u0442 \u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0432\u044b\u0433\u043e\u0434\u044b, \u0431\u0443\u0434\u044c \u0442\u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0432\u044b\u0433\u043e\u0434\u0430 \u0438\u043b\u0438 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0441\u043f\u043e\u0440\u0442, \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u044b, \u0435\u0434\u0430, \u0441\u0435\u043a\u0441, \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.<\/li>\n<\/ol>\n<p>\u0417\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043c\u0435\u0448\u0430\u0435\u0442 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044f \u0435\u0435. \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043d\u0430\u043d\u043e\u0441\u0438\u0442 \u0432\u0440\u0435\u0434 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e, \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0444\u0435\u0440\u0435 \u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0439.<\/p>\n<p>\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0436\u0438\u0442\u044c \u0431\u0435\u0437 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f? \u041a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u043e\u0436\u043d\u043e. \u0423\u0441\u043f\u0435\u0445 \u0432 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430. \u0415\u0441\u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0433\u043e\u0442\u043e\u0432 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u0443\u0441\u0438\u043b\u0438\u0439 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0436\u0438\u0437\u043d\u0438, \u0442\u043e \u0448\u0430\u043d\u0441\u044b \u043d\u0430 \u0435\u0433\u043e \u0442\u0440\u0435\u0437\u0432\u043e\u0441\u0442\u044c \u0432\u0435\u043b\u0438\u043a\u0438.<\/p>\n<p>\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u0430\u0445. \u041e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441. \u0412 \u0446\u0435\u043d\u0442\u0440\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b. \u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441 \u0434\u0435\u043b\u0430\u0435\u0442 \u0434\u0435\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044e \u043d\u0430 \u0431\u0430\u0437\u0435 \u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043b\u0438\u043d\u0438\u043a\u0438, \u0430 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435, \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044f\u0442 \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440 \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0438 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0412 \u0446\u0435\u043d\u0442\u0440\u0435 \u0435\u0441\u0442\u044c \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438, \u043f\u0441\u0438\u0445\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438 \u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u044b \u043f\u043e \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430 \u0441\u0432\u043e\u0435\u043c \u043e\u043f\u044b\u0442\u0435 \u0438 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0437\u043d\u0430\u043d\u0438\u044f\u043c\u0438 \u043d\u0430\u0443\u0447\u0430\u0442 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u0436\u0438\u0442\u044c \u0432 \u0442\u0440\u0435\u0437\u0432\u043e\u0441\u0442\u0438.<\/p>\n<p>\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0442 \u043d\u0430\u0440\u043a\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u043e\u0435, \u0442\u0430\u043a \u043a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u0441\u043e\u0431\u043e\u0439 &#8212; \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0439 \u0442\u0440\u0443\u0434. \u042d\u0442\u043e \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441, \u043d\u043e \u0435\u0441\u043b\u0438 \u0436\u0438\u0437\u043d\u044c \u0432\u0430\u0436\u043d\u0435\u0435 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432, \u0442\u043e \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c. \u041d\u0435 \u0442\u0435\u0440\u044f\u0439 \u0432\u0440\u0435\u043c\u044f, \u0442\u0432\u043e\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c, \u0430 \u0435\u0441\u0442\u044c \u0448\u0430\u043d\u0441\u044b \u0447\u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0448\u044c \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c \u0438 \u0442\u0440\u0435\u0437\u0432\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0435\u0434\u0451\u0442 \u0441\u043e\u0437\u0438\u0434\u0430\u044e\u0449\u0438\u0439 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u0438 \u0432\u043d\u043e\u0441\u0438\u0442 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0436\u0438\u0437\u043d\u044c \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0417\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0430\u0432\u043d\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u0438 \u0434\u043e \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u043f\u043e\u0440 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u043b \u0447\u0442\u043e \u0441 \u043d\u0435\u0439 \u0434\u0435\u043b\u0430\u0442\u044c. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0447\u0451\u043d\u044b\u0445, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e\u0432 \u0438 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u043e\u0432 \u0434\u0430\u044e\u0442 \u043d\u0430\u043c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u