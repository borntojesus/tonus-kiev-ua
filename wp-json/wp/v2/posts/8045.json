{"id":8045,"date":"2020-11-05T18:01:01","date_gmt":"2020-11-05T15:01:01","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8045"},"modified":"2020-11-05T18:01:38","modified_gmt":"2020-11-05T15:01:38","slug":"posledstvija-narkotikov","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/posledstvija-narkotikov\/","title":{"rendered":"\u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432"},"content":{"rendered":"<blockquote><p><em><span style=\"font-size: 12pt;\">\u041d\u044b\u043d\u0435\u0448\u043d\u044f\u044f \u0441\u043b\u043e\u0436\u043d\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0432 \u0423\u043a\u0440\u0430\u0438\u043d\u0435 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430, \u043a\u0430\u0440\u0430\u043d\u0442\u0438\u043d\u0430 \u0438 \u0441\u0430\u043c\u043e\u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0432\u0435\u0434\u0451\u0442 \u043a \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044e \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e \u0438 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0430 \u0432\u043c\u0435\u0441\u0442\u0435 \u0438 \u0441 \u043d\u0438\u043c \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.<\/span> <\/em><\/p><\/blockquote>\n<p>\u041d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043c\u043e\u0433\u0443\u0442 \u043d\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u044f, \u0434\u0430\u0442\u044c \u0437\u0430\u0440\u044f\u0434 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0430, \u044d\u0439\u0444\u043e\u0440\u0438\u0438 \u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f, \u043d\u043e \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043e\u0442 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0431\u0443\u0434\u0443\u0442 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u0431\u0438\u0442\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e, \u0430 \u0432 \u043f\u043b\u043e\u0442\u044c \u0434\u043e \u043f\u043e\u0442\u0435\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u0440\u0430\u0437\u0432\u043e\u0434\u0430, \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u043f\u043e\u0442\u0435\u0440\u044c \u0438 \u043c\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u043e\u0433\u043e. \u0421\u0435\u0433\u043e\u0434\u043d\u044f, \u0432 \u044d\u0442\u043e\u0439 \u0441\u0442\u0430\u0442\u044c\u0435, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u044b \u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0446\u0435\u043d\u0442\u0440\u0430 \u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441 \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u044f\u0442 \u0412\u0430\u0441 \u0441 \u043f\u043b\u0430\u0447\u0435\u0432\u043d\u044b\u043c\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432.<\/p>\n<h2><strong><span style=\"font-size: 14pt;\">\u0410\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d, \u0441\u043e\u043b\u0438:<\/span><\/strong><\/h2>\n<p>\u041f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c, \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0433\u0438\u043f\u0435\u0440\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u041f\u0440\u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u043e.<br \/>\n\u0422\u0430\u043a\u0436\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0435\u0442:<\/p>\n<ul style=\"list-style-type: square;\">\n<li><span style=\"color: #003366;\"><strong>\u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0434\u0438\u043f\u0440\u0435\u0441\u0438\u0438;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043d\u0435\u0440\u0432\u043e\u0437\u043d\u043e\u0441\u0442\u044c;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043f\u0430\u0440\u0430\u043d\u043e\u0439\u044f;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u0435 \u0441\u043d\u0430;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043d\u0435\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u044b\u0435 \u0436\u0435\u0441\u0442\u0438\u043a\u0443\u043b\u044f\u0446\u0438\u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u043f\u043e\u0434\u0451\u0440\u0433\u0438\u0432\u0430\u043d\u0438\u0435 \u0447\u0435\u043b\u044e\u0441\u0442\u0438;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0432 \u043f\u0441\u0438\u0445\u0438\u043a\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u041f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043d\u0435 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u043c.<\/strong> <\/span><\/li>\n<\/ul>\n<p><em>\u0415\u0441\u043b\u0438 \u0432\u043e\u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432 \u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440 \u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441, \u0442\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043a \u0437\u0434\u0440\u0430\u0432\u043e\u043c\u044b\u0441\u043b\u0438\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.<\/em><\/p>\n<h3><strong><span style=\"font-size: 14pt;\">\u041c\u0430\u0440\u0438\u0445\u0443\u0430\u043d\u0430, \u043a\u043e\u043d\u043e\u043f\u043b\u044f, \u0441\u043f\u0430\u0439\u0441:<\/span><\/strong><\/h3>\n<p>\u0423\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0447\u0430\u0441\u0442\u043e <span style=\"color: #003366;\"><strong>\u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043f\u0441\u0438\u0445\u043e\u0437\u0443 \u0438 \u043d\u0435\u0432\u0440\u043e\u0437\u0443<\/strong><\/span>. \u0421\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0440\u0438\u0445\u0443\u0430\u043d\u044b \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f <span style=\"color: #003366;\"><strong>\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0432 \u043f\u0430\u043c\u044f\u0442\u0438, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e<\/strong><\/span>.<\/p>\n<h3><strong><span style=\"font-size: 14pt;\">\u0413\u0435\u0440\u043e\u0438\u043d, \u043c\u0435\u0442\u0430\u0434\u043e\u043d, \u043e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438:<\/span><\/strong><\/h3>\n<p>\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u043a\u0430\u043a\u0443\u044e \u043b\u0438\u0431\u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043e\u043d \u043c\u0435\u0434\u043b\u0438\u0442\u0435\u043b\u0435\u043d. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 &#171;\u0445\u043e\u0434\u044f\u0447\u0435\u0433\u043e \u043c\u0435\u0440\u0442\u0432\u0435\u0446\u0430&#187;. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u043e\u0442 \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430 \u0438\u043b\u0438 \u0433\u0435\u0440\u043e\u0438\u043d\u0430 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0441\u0430\u043c\u044b\u043c\u0438 \u0442\u044f\u0436\u0451\u043b\u044b\u043c\u0438, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e:<\/p>\n<ul style=\"list-style-type: square;\">\n<li><span style=\"color: #003366;\"><strong>\u0413\u0435\u043f\u0430\u0442\u0438\u0442 \u0412 \u0438 \u0421;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0412\u0418\u0427, \u0421\u041f\u0418\u0414;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0437\u0443\u0431\u043e\u0432;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0432 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430;<\/strong><\/span><\/li>\n<li><span style=\"color: #003366;\"><strong>\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0435\u0447\u0435\u043d\u0438.<\/strong><\/span><\/li>\n<\/ul>\n<p><em>\u0421\u0440\u0435\u0434\u043d\u0435\u0435 <span style=\"color: #003366;\"><strong>\u0432\u0440\u0435\u043c\u044f \u0436\u0438\u0437\u043d\u0438 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430<\/strong><\/span>, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0435\u0442 \u043e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0432\u0438\u0434\u044b \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432, \u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0444\u0430\u0437\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f <span style=\"color: #003366;\"><strong>\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 7-10 \u043b\u0435\u0442<\/strong><\/span>. \u0427\u0430\u0441\u0442\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0438 \u043f\u0435\u0440\u0435\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438.<\/em><\/p>\n<p>\u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u0432 \u0441\u0435\u043c\u044c\u044f\u0445 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442\u044c \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044b, \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0434\u043e\u0432\u0435\u0440\u0438\u0435 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0434\u0440\u0443\u0437\u044c\u044f \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u044e\u0442 \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f, \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0440\u0430\u0434\u0438 \u0434\u043e\u0437\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0431\u0440\u0430\u0442\u044c \u043a\u0440\u0435\u0434\u0438\u0442\u044b \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0434\u0435\u043d\u044c\u0433\u0438 \u0443 \u0432\u0441\u0435\u0445 \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445, \u0446\u0435\u043d\u043d\u044b\u0435 \u0432\u0435\u0449\u0438 \u0437\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0432 \u043b\u043e\u043c\u0431\u0430\u0440\u0434, \u0441 \u0440\u0430\u0431\u043e\u0442\u044b \u0442\u0430\u043a\u0438\u0445 &#171;\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432&#187; \u0443\u0432\u043e\u043b\u044c\u043d\u044f\u044e\u0442.<\/p>\n<p>\u0418\u0437 \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0444\u0430\u0437\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u0442\u043e \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0435\u0433\u043e \u0436\u0434\u0451\u0442 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439. \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0441\u0430\u043c \u043d\u0435 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435, \u0435\u043c\u0443 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u0438\u0437\u0432\u043d\u0435. \u0412 \u0434\u0440\u0443\u0433\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0438\u0441\u0445\u043e\u0434 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c\u0441\u044f \u0441\u043c\u0435\u0440\u0442\u044c\u044e, \u0442\u044e\u0440\u044c\u043c\u043e\u0439, \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0435\u043c.<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u041d\u044b\u043d\u0435\u0448\u043d\u044f\u044f \u0441\u043b\u043e\u0436\u043d\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0432 \u0423\u043a\u0440\u0430\u0438\u043d\u0435 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430, \u043a\u0430\u0440\u0430\u043d\u0442\u0438\u043d\u0430 \u0438 \u0441\u0430\u043c\u043e\u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0432\u0435\u0434\u0451\u0442 \u043a \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044e \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e \u0438 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0430 \u0432\u043c\u0435\u0441\u0442\u0435 \u0438 \u0441 \u043d\u0438\u043c \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438. \u041d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043c\u043e\u0433\u0443\u0442 \u043d\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u044f, \u0434\u0430\u0442\u044c \u0437\u0430\u0440\u044f\u0434 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0430, \u044d\u0439\u0444\u043e\u0440\u0438\u0438 \u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f, \u043d\u043e \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c&#8230;<\/p>\n","protected":false},"aut