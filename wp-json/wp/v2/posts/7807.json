{"id":7807,"date":"2020-03-16T01:41:29","date_gmt":"2020-03-15T22:41:29","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=7807"},"modified":"2020-03-16T01:57:59","modified_gmt":"2020-03-15T22:57:59","slug":"narkotik-metadon","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/narkotik-metadon\/","title":{"rendered":"\u041d\u0430\u0440\u043a\u043e\u0442\u0438\u043a &#8212; \u041c\u0435\u0442\u0430\u0434\u043e\u043d, \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f, \u043b\u043e\u043c\u043a\u0430"},"content":{"rendered":"<blockquote><p><em><span style=\"font-size: 12pt;\">\u041c\u0435\u0442\u0430\u0434\u043e\u043d \u2013 \u044d\u0442\u043e \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0431\u044b\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d \u043a\u0430\u043a \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u0438 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0432 1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0432 \u0421\u0428\u0410, \u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u043c\u043e\u0440\u0444\u0438\u043d\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0445 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.<\/span><\/em><\/p><\/blockquote>\n<p><strong>\u041d\u0435\u043c\u043d\u043e\u0433\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438.<\/strong><\/p>\n<p><img class=\"alignleft wp-image-7809 size-medium\" src=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-254x300.jpg\" alt=\"\u0422\u043e\u043c\u0430\u0441 \u0421\u0438\u0434\u043d\u0435\u0445\u0430\u043c\" width=\"254\" height=\"300\" srcset=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-254x300.jpg 254w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-868x1024.jpg 868w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-72x85.jpg 72w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-242x286.jpg 242w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4-68x80.jpg 68w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/1246959751_4.jpg 1000w\" sizes=\"(max-width: 254px) 100vw, 254px\" \/><br \/>\n\u041c\u043d\u043e\u0433\u0438\u0435 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u043e\u043f\u0438\u0430\u0442\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0434\u043b\u044f \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0438, \u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0431\u044b\u043b\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u043d\u044b \u0432\u0440\u0430\u0447\u0430\u043c\u0438 \u0441 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u043e\u043c. \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0445 \u0432\u0440\u0430\u0447\u0435\u0439, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0438\u0445 \u043e\u043f\u0438\u0443\u043c \u0432 \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u0438 \u0431\u043e\u043b\u0438 \u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u0439 \u0441\u0432\u043e\u0438\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0431\u044b\u043b \u0422\u043e\u043c\u0430\u0441 \u0421\u0438\u0434\u043d\u0435\u0445\u0430\u043c. \u041e\u043f\u0438\u0443\u043c \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b\u0441\u044f \u044d\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0432 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u044f\u0445, \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0440\u0435\u0436\u0435 \u0435\u0433\u043e \u043a\u0443\u0440\u0438\u043b\u0438. \u0412 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0430\u0434\u043d\u044b\u043c \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043e\u043f\u0438\u0443\u043c\u0430 \u0438 \u0443\u0436\u0435 \u043d\u0435 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u043a \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e<\/p>\n<p>\u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u043f\u0440\u0438\u0431\u0430\u0432\u0438\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u0412 1803 \u0433\u043e\u0434\u0443 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442 \u0421\u0435\u0440\u0442\u0443\u0440\u043d\u0435\u0440 \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u0432\u044b\u0434\u0435\u043b\u044f\u0442\u044c \u043c\u043e\u0440\u0444\u0438\u0439 \u0438\u0437 \u043e\u043f\u0438\u0443\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0440\u0430\u0437 \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u043e\u043f\u0438\u0443\u043c\u0430-\u0441\u044b\u0440\u0446\u0430. \u0421\u0435\u0440\u0442\u0443\u0440\u043d\u0435\u0440 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043b \u0441 \u043c\u043e\u0440\u0444\u0438\u0435\u043c \u0438 \u0431\u044b\u043b \u0442\u0430\u043a \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d \u0431\u043b\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0441\u043e\u043d\u043b\u0438\u0432\u044b\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d \u0432\u044b\u0437\u044b\u0432\u0430\u043b, \u0447\u0442\u043e \u043d\u0430\u0437\u0432\u0430\u043b \u0435\u0433\u043e \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0431\u043e\u0433\u0430 \u0441\u043d\u0430 \u041c\u043e\u0440\u0444\u0438\u044f. \u0412 XIX \u0432\u0435\u043a\u0435 \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0430\u044f \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043d\u0430\u0448\u043b\u0430 \u00ab\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\u00bb \u043e\u0442 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u0430.\u0421\u0442\u0440\u0430\u0434\u0430\u044e\u0449\u0438\u0439 \u044d\u0442\u0438\u043c \u043d\u0435\u0434\u0443\u0433\u043e\u043c, \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u044d\u0442\u043e \u00ab\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u043e\u00bb, \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u043b \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044e.<\/p>\n<p>\u041c\u043e\u0440\u0444\u0438\u0439 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 XIX \u0432\u0435\u043a\u0430, \u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0448\u043f\u0440\u0438\u0446\u0430 \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438 \u043c\u043e\u0440\u0444\u0438\u043d\u0430 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438 \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438 \u0410\u043c\u0435\u0440\u0438\u043a\u0435.<\/p>\n<p>\u0427\u0442\u043e\u0431\u044b \u0440\u0435\u0448\u0438\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043c\u043e\u0440\u0444\u0438\u044f \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043b\u0435\u0447\u0435\u0431\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f \u043a\u043e\u043a\u0430\u0438\u043d. \u041f\u0435\u0440\u0432\u043e\u043f\u0440\u043e\u0445\u043e\u0434\u0446\u0435\u043c \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0431\u044b\u043b \u0417. \u0424\u0440\u0435\u0439\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043d\u0438\u043c\u0430\u043b \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043c\u043e\u0440\u0444\u0438\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u043a\u0430\u0438\u043d\u0430, \u043e\u0434\u043d\u0430\u043a\u043e \u0432\u0441\u043a\u043e\u0440\u0435 \u0438 \u0441\u0430\u043c \u0441\u0442\u0430\u043b \u0437\u0430\u0432\u0438\u0441\u0438\u043c \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.<\/p>\n<p>\u0412 1898 \u0433\u043e\u0434\u0443 \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442 \u0413\u0435\u043d\u0440\u0438\u0445 \u0414\u0440\u0435\u0437\u0435\u0440 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b \u043c\u043e\u0440\u0444\u0438\u043d \u0432 \u0433\u0435\u0440\u043e\u0438\u043d. \u0413\u0435\u0440\u043e\u0438\u043d \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043d\u0430\u0447\u0430\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043c\u043e\u0440\u0444\u0438\u043d\u0438\u0437\u043c\u0430, \u043f\u043e\u043a\u0430 \u0447\u0435\u0440\u0435\u0437 \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442 \u043d\u0435 \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u043e\u043d \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0435\u0449\u0451 \u0431\u043e\u043b\u0435\u0435 \u0441\u0438\u043b\u044c\u043d\u0443\u044e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0447\u0435\u043c \u043c\u043e\u0440\u0444\u0438\u043d, \u043e\u0434\u043d\u0430\u043a\u043e \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0441 \u0432\u0437\u043b\u0451\u0442\u043e\u043c \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438 \u0438 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u0438 \u0443\u0436\u0435 \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e\u0441\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c.<\/p>\n<p>\u041e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0435 \u00ab\u0440\u0435\u0448\u0435\u043d\u0438\u0435\u00bb \u044d\u0442\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043f\u0440\u0438\u0448\u043b\u043e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u0434\u043e\u043b\u043e\u0444\u0438\u043d\u043e\u043c, \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u0432 1944 \u0433\u043e\u0434\u0443 \u0432 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043a\u043e\u0439 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438 \u0438 \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u043c \u0442\u0430\u043a \u0432 \u0447\u0435\u0441\u0442\u044c \u0410\u0434\u043e\u043b\u044c\u0444\u0430 \u0413\u0438\u0442\u043b\u0435\u0440\u0430. \u041f\u0440\u0430\u0432\u0434\u0430, \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0441\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430 \u043c\u0435\u0442\u0430\u0434\u043e\u043d, \u043d\u043e, \u0447\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u00ab\u0437\u0430\u0431\u0430\u0432\u043d\u043e\u00bb, \u0435\u0433\u043e \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u0434\u043b\u044f \u00ab\u043b\u0435\u0447\u0435\u043d\u0438\u044f\u00bb \u0433\u0435\u0440\u043e\u0438\u043d\u043e\u0432\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.<\/p>\n<blockquote><p><span style=\"font-size: 12pt;\"><strong>\u041c\u0435\u0442\u0430\u0434\u043e\u043d \u2013 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a \u0442\u043e\u0439 \u0436\u0435 \u0433\u0440\u0443\u043f\u043f\u044b, \u0447\u0442\u043e \u0438 \u0433\u0435\u0440\u043e\u0438\u043d.<\/strong> <em>\u0421\u0443\u0442\u044c \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u043e\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b: \u043d\u0430\u0440\u043a\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u043b\u0435\u0447\u0438\u0442\u044c\u0441\u044f \u0438 \u043a \u0442\u043e\u043c\u0443 \u0436\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u044b \u0412\u0418\u0427, \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c \u0432\u044b\u0434\u0430\u0432\u0430\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0443\u044e \u0434\u043e\u0437\u0443 \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0421\u041f\u0418\u0414\u0430, \u0430 \u0437\u0430\u043e\u0434\u043d\u043e \u0438 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u043d\u0430\u0440\u043a\u043e\u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c.<\/em><\/span><\/p><\/blockquote>\n<p><strong>\u0418\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u044d\u0442\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u044b \u0432\u0438\u0434\u0438\u043c \u043f\u043e\u0440\u043e\u0447\u043d\u044b\u0439 \u043a\u0440\u0443\u0433, \u043e\u0434\u043d\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0437\u0430\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0434\u0440\u0443\u0433\u043e\u0439 \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043d\u0435 \u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0433\u0440\u043e\u043c\u043a\u0438\u0435 &#187; \u043f\u043b\u044e\u0441\u044b &#187; \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0435\u0440\u0435\u0440\u0430\u0441\u0442\u0430\u044e\u0442 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u043c\u0438\u043d\u0443\u0441\u044b \u0432\u043e \u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 \u0436\u0438\u0437\u043d\u0438 (\u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u0435, \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u043f\u0441\u0438\u0445\u0438\u043a\u0430, \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438 \u0438 \u0442.\u0434), \u0432\u0435\u0437\u0434\u0435 \u0432\u0438\u0434\u0438\u043c \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0449\u0435\u0440\u0431.<\/strong><\/p>\n<p><img class=\"aligncenter size-full wp-image-7811\" src=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000.jpg\" alt=\"\u043c\u0435\u0442\u0430\u0434\u043e\u043d\u043e\u0432\u0430\u044f \u043b\u043e\u043c\u043a\u0430 \u0441\u043d\u044f\u0442\u0438\u0435\" width=\"800\" height=\"517\" srcset=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000.jpg 800w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000-300x194.jpg 300w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000-132x85.jpg 132w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000-242x156.jpg 242w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/03\/90000-80x52.jpg 80w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/><\/p>\n<h2><span style=\"font-size: 18pt;\">\u041a\u0430\u043a \u0441\u043d\u044f\u0442\u044c \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u043e\u0432\u0443\u044e \u043b\u043e\u043c\u043a\u0443 (\u043a\u0430\u043a \u043e\u0442\u043e\u0439\u0442\u0438 \u043e\u0442 \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430)<\/span><\/h2>\n<p>\u0421\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u043e\u0442 \u0432\u0438\u0434 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\u00a0 \u043d\u0435 \u0438\u0437\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043e\u0442 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438, \u043e\u043d \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0435. \u041c\u0435\u0442\u0430\u0434\u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u043f\u0438\u043e\u0438\u0434\u043e\u043c, \u0438 \u043f\u0440\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0435\u0433\u043e \u043f\u0440\u0438\u0435\u043c\u0430 (\u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e) \u0443 \u0432\u0430\u0441 \u043d\u0430\u0447\u043d\u0435\u0442\u0441\u044f \u043b\u043e\u043c\u043a\u0430 \u043e\u0442 \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430 (\u0430\u0431\u0441\u0442\u0438\u043d\u0435\u043d\u0442\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c). \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0441\u043b\u0438 \u0432\u044b \u0440\u0435\u0448\u0438\u0442\u0435 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u0435 \u043e\u0431 \u044d\u0442\u043e\u043c \u043b\u0435\u0447\u0430\u0449\u0435\u043c\u0443 \u0432\u0440\u0430\u0447\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u0442 <a href=\"https:\/\/tonus.kiev.ua\/snjatie-lomki-kiev\/\"><strong>\u043e\u0442\u043c\u0435\u043d\u0443 \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430 \u00ab\u0431\u0435\u0437 \u043b\u043e\u043c\u043a\u0438\u00bb<\/strong><\/a>.<\/p>\n<p style=\"text-align: center;\"><strong>\u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u0442 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f, \u0442\u0440\u0430\u043d\u043a\u0432\u0438\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u0432, \u0441\u043d\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0445, \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432, \u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u0451\u043c \u043c\u0435\u0442\u0430\u0434\u043e\u043d\u0430 \u043d\u0435 \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0438\u0445 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c: \u0432\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435.<\/strong><\/p>\n<blockquote><p><em><span style=\"font-size: 12pt;\">\u041c\u0435\u0442\u0430\u0434\u043e\u043d \u043d\u0435 \u043b\u0435\u0447\u0438\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u043e \u0441\u043d\u043e\u043c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e,\u00a0 \u0442\u0440\u0435\u0432\u043e\u0433\u0443 \u0438 \u0442.\u0434 \u0435\u0441\u043b\u0438 \u043e\u043d\u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441 \u00ab\u043b\u043e\u043c\u043a\u043e\u0439\u00bb. \u0414\u043b\u044f \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u044d\u0442\u0438\u0445 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439 \u0442\u0435\u0431\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e <a href=\"https:\/\/tonus.kiev.ua\/lechenie-metadonovoj-zavisimosti\/\">\u043b\u0435\u0447\u0435\u043d\u0438\u0435<\/a>, \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430 \u0438 <a href=\"https:\/\/tonus.kiev.ua\/narkologicheskaja-pomoshh\/\">\u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0430<\/a>, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430\u044f <a href=\"https:\/\/tonus.kiev.ua\/reabilitacija-narkozavisimyh-v-kieve\/\">\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438<\/a>.<\/span><\/em><\/p><\/blockquote>\n","protected":false},"excerpt":{"rendered":"<p>\u041c\u0435\u0442\u0430\u0434\u043e\u043d \u2013 \u044d\u0442\u043e \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0431\u044b\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d \u043a\u0430\u043a \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u0438 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0432 1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0432 \u0421\u0428\u0410, \u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u043c\u043e\u0440\u0444\u0438\u