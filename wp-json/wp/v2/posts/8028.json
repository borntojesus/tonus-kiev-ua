{"id":8028,"date":"2020-10-21T17:05:54","date_gmt":"2020-10-21T14:05:54","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8028"},"modified":"2020-10-21T17:07:17","modified_gmt":"2020-10-21T14:07:17","slug":"sovety-psihologa-roditeljam-narkomana","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/sovety-psihologa-roditeljam-narkomana\/","title":{"rendered":"\u0421\u043e\u0432\u0435\u0442\u044b \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0430"},"content":{"rendered":"<p>\u0415\u0441\u043b\u0438 \u0443 \u0412\u0430\u0448\u0435\u0433\u043e \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0438\u043b\u0438 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\u043c \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u0442\u043e \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0442\u0430\u043a\u0438\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439:<\/p>\n<ol>\n<li><span style=\"color: #003366;\"><strong>\u041f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430.<\/strong><\/span><br \/>\n\u0427\u0430\u0441\u0442\u043e, \u043b\u044e\u0434\u0438 \u0436\u0438\u0432\u0443\u0449\u0438\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0438\u0433\u0440\u0430\u044e\u0442 \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u044e\u0442 \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044e.<br \/>\n\u0412\u044b \u0447\u0430\u0441\u0442\u043e \u0434\u0430\u0451\u0442\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430 \u043d\u0435 \u0446\u0435\u043b\u0435\u0432\u044b\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u044b, \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044b, \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0435\u0441\u044c \u0433\u0438\u043f\u0435\u0440\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c, \u043e\u0442\u0434\u0430\u0435\u0442\u0435 \u0435\u0433\u043e \u0434\u043e\u043b\u0433\u0438 \u0438\u043b\u0438 \u0432\u044b\u043a\u0443\u043f\u0430\u0435\u0442\u0435 \u0432\u0435\u0449\u0438 \u0438\u0437 \u043b\u043e\u043c\u0431\u0430\u0440\u0434\u043e\u0432, \u043f\u044b\u0442\u0430\u0435\u0442\u0435\u0441\u044c \u0440\u0435\u0448\u0438\u0442\u044c \u0432\u0441\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435\/\u0443\u0447\u0435\u0431\u0435 \u0438\u043b\u0438 \u0432 \u043f\u043e\u043b\u0438\u0446\u0438\u0438. \u042d\u0442\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a \u0412\u044b \u0438\u043b\u0438 \u043d\u0435\u0442.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0411\u044b\u0442\u044c \u0447\u0435\u0441\u0442\u043d\u044b\u043c \u0437\u0435\u0440\u043a\u0430\u043b\u043e\u043c.<\/strong><\/span><br \/>\n\u042d\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0433\u043b\u0430\u0441\u0438\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0435\u043c\u0443 \u0432 \u043b\u0438\u0446\u043e \u0432\u0441\u0435 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0434\u0435\u043b\u0430\u0435\u0442 \u0438 \u043a\u0430\u043a\u043e\u0439 \u0443\u0449\u0435\u0440\u0431 \u043e\u043d \u0412\u0430\u043c \u043d\u0430\u043d\u043e\u0441\u0438\u0442 \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f.<br \/>\n\u0412\u044b \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0435, \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435 \u043b\u0438\u0448\u044c \u0442\u043e, \u0447\u0442\u043e \u0443\u0434\u043e\u0431\u043d\u043e \u0412\u0430\u043c, \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0443\u0435\u0442\u0435 \u0438\u043c, \u043f\u044b\u0442\u0430\u0435\u0442\u0435\u0441\u044c \u043e\u0442\u043e\u043c\u0441\u0442\u0438\u0442\u044c, \u0437\u043b\u0438\u0442\u044c, \u043e\u0431\u0438\u0436\u0430\u0435\u0442\u0435\u0441\u044c, \u0432\u0435\u0440\u0438\u0442\u0435 \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c. \u042d\u0442\u0438 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u043c\u043e\u0433\u0443\u0442 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0439\u0434\u0435\u0442 \u0434\u0430\u043b\u044c\u0448\u0435 \u0438\u0441\u043a\u0430\u0442\u044c \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a \u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0430\u043a\u0442.<\/strong><\/span><br \/>\n\u042d\u0442\u043e\u0442 \u043f\u0443\u043d\u043a\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u0432\u0430\u0436\u043d\u044b\u043c \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u0442\u0430\u043b \u043d\u0430 \u043f\u0443\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f. \u0412\u0430\u043c, \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0433\u0440\u0430\u043d\u0438\u0446\u044b, \u0430 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0432\u0441\u044f\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0447\u0442\u043e \u043e\u043d \u0412\u0430\u043c \u043d\u0435 \u0431\u0435\u0437\u0440\u0430\u0437\u043b\u0438\u0447\u0435\u043d, \u0438 \u043e\u043d \u0412\u0430\u043c \u0434\u043e\u0440\u043e\u0433. \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0432 \u044d\u0442\u0443 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043c\u043e\u0436\u0435\u0442 \u0440\u0435\u0448\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435. \u0415\u0441\u043b\u0438 \u0436\u0435 \u0412\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0435\u0433\u043e \u0432\u043e \u0432\u0441\u0435\u043c \u0443\u043f\u0440\u0435\u043a\u0430\u0442\u044c \u0438 \u0443\u043d\u0438\u0436\u0430\u0442\u044c, \u0442\u043e \u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u043d\u0430 \u0432\u0430\u0441 \u043e\u0431\u0438\u0436\u0435\u043d, \u0438 \u043d\u0435 \u043e \u043a\u0430\u043a\u0438\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432 \u043b\u0443\u0447\u0448\u0443\u044e \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043d\u0435 \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f.<br \/>\n\u0412\u0430\u043c \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u043a\u0440\u0438\u0447\u0430\u0442\u044c \u043d\u0430 \u043d\u0435\u0433\u043e \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u0444\u0430\u043a\u0442\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f, \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0435\u0433\u043e &#171;\u0431\u0435\u0441\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u043c&#187;, \u043d\u0435 \u0441\u0442\u044b\u0434\u0438\u0442\u044c \u0435\u0433\u043e. \u041f\u043e\u0439\u043c\u0438\u0442\u0435, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0445\u043e\u0447\u0435\u0442 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435, \u0442\u043e \u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435 \u043e\u0442 \u043d\u0435\u0433\u043e \u0437\u0430\u0432\u0438\u0441\u044f\u0449\u0435\u0435 \u0438 \u043f\u0440\u0438 \u043d\u0435\u0443\u0434\u0430\u0447\u0430\u0445 \u0435\u0433\u043e \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u0442\u0430\u0442\u044c \u0440\u043e\u043b\u0435\u0432\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c \u0432 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0438.<\/strong><\/span><br \/>\n\u0415\u0441\u043b\u0438 \u0436\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442 \u043f\u0435\u0440\u0432\u044b\u043c \u0438\u0434\u0442\u0438 \u043d\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u0442\u043e \u044d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0412\u0430\u043c. \u041e\u043d \u0443\u0432\u0438\u0434\u0438\u0442 \u0447\u0442\u043e \u0412\u044b \u0433\u043e\u0442\u043e\u0432\u044b \u0440\u0430\u0434\u0438 \u043d\u0435\u0433\u043e \u043d\u0430 \u0432\u0441\u0451, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0438 \u044d\u0442\u043e \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0451\u0442 \u0435\u0433\u043e \u043d\u0430 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435.<\/li>\n<\/ol>\n<p>\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0412\u0430\u043c \u0441\u0442\u043e\u0438\u0442 \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u043d\u0430\u0447\u0430\u0442\u044c \u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u0433\u0440\u0443\u043f\u043f\u044b \u0434\u043b\u044f \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445. \u0422\u0430\u043a\u0436\u0435 \u0432\u0430\u0436\u043d\u043e \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430\u043c \u0438 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c.<\/p>\n<p>\u0411\u043b\u0438\u0437\u043a\u0438\u0435, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043b\u044e\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0442 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u0438\u0433\u0440\u0430\u044e\u0442 \u0432\u0430\u0436\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u041a\u0442\u043e-\u0442\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430, \u043a\u0442\u043e-\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0433\u043b\u0430\u0437\u0430 \u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e, \u043a\u0430\u043a \u0431\u044b \u043d\u0435 \u0432\u0435\u0440\u044f \u044d\u0442\u043e, \u043a\u0442\u043e-\u0442\u043e \u0432\u0435\u0440\u0438\u0442 \u0432 \u0442\u043e, \u0447\u0442\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0441\u0430\u043c \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439. \u042d\u0442\u043e \u0432\u0441\u0435 \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f. \u0414\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u043b\u043e\u043d\u0438\u0442\u044c \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0435\u043c\u0443 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u0442\u0430\u043a\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432.<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0415\u0441\u043b\u0438 \u0443 \u0412\u0430\u0448\u0435\u0433\u043e \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0438\u043b\u0438 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\u043c \u043f\u0441\u0438\u0445\u043e\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u0442\u043e \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0442\u0430\u043a\u0438\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439: \u041f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430. \u0427\u0430\u0441\u0442\u043e, \u043b\u044e\u0434\u0438 \u0436\u0438\u0432\u0443\u0449\u0438\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0438\u0433\u0440\u0430\u044e\u0442 \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u044e\u0442 \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044e. \u0412\u044b \u0447\u0430\u0441\u0442\u043e \u0434\u0430\u0451\u0442\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430 \u043d\u0435 \u0446\u0435\u043b\u0435\u0432\u044b\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u044b, \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044b, \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0435\u0441\u044c \u0433\u0438\u043f\u0435\u0440\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c, \u043e\u0442\u0434\u0430\u0435\u0442\u0435 \u0435\u0433\u043e \u0434\u043e\u043b\u0433\u0438 \u0438\u043b\u0438 \u0432\u044b\u043a\u0443\u043f\u0430\u0435\u0442\u0435 \u0432\u0435\u0449\u0438&#8230;<\/p>\n","protected":false},"author":1,"featured_media":8029,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":[],"categories":[1],"tags":[],"yst_prominent_words":[653,334,2073,47,267,2071,1708,505,325,977,2070,34,2072,2069,2068,567,1490,825,225],"_links":{"self":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/posts\/8028"}],"collection":[{"href":"https:\/\/to