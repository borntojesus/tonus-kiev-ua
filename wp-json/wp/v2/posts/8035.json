{"id":8035,"date":"2020-10-27T11:39:26","date_gmt":"2020-10-27T08:39:26","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8035"},"modified":"2020-10-27T12:03:55","modified_gmt":"2020-10-27T09:03:55","slug":"pomoshh-blizkomu","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/pomoshh-blizkomu\/","title":{"rendered":"\u0415\u0441\u043b\u0438 \u0412\u0430\u0448 \u0431\u043b\u0438\u0437\u043a\u0438\u0439 \u043f\u043e\u043f\u0430\u043b \u0432 \u043a\u0440\u0443\u0433 \u043d\u0430\u0440\u043a\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0438 \u0445\u043e\u0447\u0435\u0442 \u0438\u0437 \u043d\u0435\u0433\u043e \u0432\u044b\u0439\u0442\u0438, \u0442\u043e \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u0441\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u044d\u0442\u043e\u043c"},"content":{"rendered":"<p>\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0412\u0430\u043c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f:<\/p>\n<ol>\n<li><span style=\"color: #003366;\"><strong>\u041f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u0440\u043e\u043b\u044c \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u043a\u0430.<\/strong><\/span> \u0412 \u044d\u0442\u043e\u043c \u043f\u0443\u043d\u043a\u0442\u0435 \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u043e\u0447\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0432\u0435\u0449\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0412\u044b \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u0435\u0442 \u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u043c\u0443 \u0432 \u0412\u0430\u0448\u0435\u043c \u0434\u043e\u043c\u0435, \u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0442\u0435\u0445 \u0432\u0435\u0449\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0412\u044b \u043d\u0435 \u0432 \u043a\u043e\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442\u0435 \u0434\u0435\u043b\u0430\u0442\u044c \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e. \u0416\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u0432\u0441\u0435\u0445 \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438 \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u043b\u0438\u0441\u0442\u0435 \u0441\u043f\u0438\u0441\u043e\u043a \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u0437\u0430\u043f\u0440\u0435\u0442\u043e\u0432. \u042d\u0442\u043e \u043f\u0435\u0440\u0432\u043e\u0435 \u0447\u0442\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c. \u041e\u0447\u0435\u043d\u044c \u0432\u0430\u0436\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0412\u044b \u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u043b\u0438 \u0432\u0441\u0435 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u043f\u0440\u0435\u0442\u044b. \u0415\u0441\u043b\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0431\u0443\u0434\u0435\u0442 \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f, \u0442\u043e \u0412\u0430\u043c \u0441\u0442\u043e\u0438\u0442 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0435\u043c\u0443 \u0447\u0442\u043e\u0431 \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0412\u0430\u0448 \u0434\u043e\u043c.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0411\u044b\u0442\u044c \u0447\u0435\u0441\u0442\u043d\u044b\u043c \u0437\u0435\u0440\u043a\u0430\u043b\u043e\u043c.<\/strong><\/span> \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e, \u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0430\u0432\u0434\u0443. \u0416\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e \u0438 \u0447\u0435\u0442\u043a\u043e \u0440\u0435\u0447\u044c \u0438 \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u0432\u0441\u0435 \u043f\u0440\u043e\u0434\u0443\u043c\u0430\u0442\u044c. \u0412\u0430\u0436\u043d\u043e \u0434\u043e\u043d\u043e\u0441\u0438\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0431\u0435\u0437 \u0438\u0437\u043b\u0438\u0448\u043d\u0438\u0445 \u044d\u043c\u043e\u0446\u0438\u0439 \u0437\u043b\u043e\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0438\u043d\u0430\u0447\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u0442 \u0412\u0430\u0448\u0438 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u044f.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0430\u043a\u0442.<\/strong><\/span> \u041d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043e\u043f\u0443\u0441\u043a\u0430\u0439\u0442\u0435 \u0440\u0443\u043a\u0438, \u0432\u0435\u0440\u044c\u0442\u0435 \u0432 \u0435\u0433\u043e, \u043c\u043e\u043b\u0438\u0442\u0435\u0441\u044c \u0437\u0430 \u0435\u0433\u043e \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435. \u041d\u043e, \u043d\u0435 \u043f\u0443\u0442\u0430\u0439\u0442\u0435 \u044d\u0442\u043e\u0442 \u043f\u0443\u043d\u043a\u0442 \u0441 \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c, \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u0440\u0438 \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u0412\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0435 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c.<\/li>\n<li><span style=\"color: #003366;\"><strong>\u0421\u0442\u0430\u0442\u044c \u0440\u043e\u043b\u0435\u0432\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c \u0432 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0438.<\/strong><\/span> \u041d\u0430 \u044d\u0442\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u0432\u0430\u0436\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0412\u044b \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0438\u0441\u044c \u0438 \u0441\u0432\u043e\u0438\u043c \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c. \u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u0433\u0440\u0443\u043f\u043f\u044b \u0441\u0430\u043c\u043e\u043f\u043e\u043c\u043e\u0449\u0438 \u0434\u043b\u044f \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445, \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f \u0441 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430\u043c\u0438 \u0438\u043b\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438 \u043f\u043e \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438, \u0437\u0430\u0439\u043c\u0438\u0442\u0435\u0441\u044c \u0441\u043f\u043e\u0440\u0442\u043e\u043c, \u043e\u0431\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438, \u043f\u043e\u0441\u0435\u0449\u0430\u0439\u0442\u0435 \u0442\u0435\u0430\u0442\u0440\u044b \u0438 \u043a\u0438\u043d\u043e\u0442\u0435\u0430\u0442\u0440\u044b.<\/li>\n<\/ol>\n<p><img class=\"lazy lazy-hidden aligncenter size-full wp-image-8039\" src=\"data:image\/svg+xml,%3Csvg xmlns=%22http:\/\/www.w3.org\/2000\/svg%22 viewBox=%220 0 1024 384%22%3E%3C\/svg%3E\" data-lazy-type=\"image\" data-src=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1.jpg\" alt=\"\u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u041a\u0438\u0435\u0432\" width=\"1024\" height=\"384\" srcset=\"\" data-srcset=\"https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1.jpg 1024w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1-300x113.jpg 300w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1-227x85.jpg 227w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1-242x91.jpg 242w, https:\/\/tonus.kiev.ua\/wp-content\/uploads\/2020\/10\/53-5-1024x384-1-80x30.jpg 80w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/p>\n<p>\u0412\u0430\u0436\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u043b\u044f \u043f\u043e\u043c\u043e\u0449\u0438 \u043d\u0430\u0440\u043a\u043e\u0437\u0430\u0432\u0438\u0441\u043c\u043e\u043c\u0443:<\/p>\n<ul style=\"list-style-type: square;\">\n<li>\u041d\u0443\u0436\u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0435 \u0447\u043b\u0435\u043d\u044b \u0441\u0435\u043c\u044c\u0438 \u0438\u043c\u0435\u043b\u0438 \u043e\u0434\u043d\u043e \u043e\u0431\u0449\u0435\u0435 \u043c\u043d\u0435\u043d\u0438\u0435, \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043e. \u0415\u0441\u043b\u0438 \u0432\u0434\u0440\u0443\u0433 \u043a\u0442\u043e-\u0442\u043e \u0438\u0437 \u0412\u0430\u0448\u0438\u0445 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0441\u043e\u0431\u043d\u0438\u0447\u0430\u0442\u044c \u0432 \u0435\u0433\u043e \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0438, \u0442\u043e \u0432\u0441\u0435 \u0412\u0430\u0448\u0438 \u0443\u0441\u0438\u043b\u0438\u044f \u0431\u0443\u0434\u0443\u0442 \u043d\u0430\u043f\u0440\u0430\u0441\u043d\u044b.<\/li>\n<li>\u0412\u0430\u043c \u0442\u0430\u043a\u0436\u0435 \u0432\u0430\u0436\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0412\u044b \u0438\u043c\u0435\u043b\u0438 \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0434\u0440\u0443\u0437\u0435\u0439, \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u043a\u043e\u043b\u043b\u0435\u0433, \u0442\u0430\u043a \u043a\u0430\u043a \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443 \u0412\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u043e\u0447\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u043b\u043e.<\/li>\n<li>\u0418\u0449\u0438\u0442\u0435 \u0432\u044b\u0445\u043e\u0434 \u0438\u0437 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u043d\u0430\u0439\u0434\u0438\u0442\u0435 \u0441\u0435\u043c\u044c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u0438 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0439\u0442\u0435 \u0443 \u043d\u0438\u0445 \u0441\u043e\u0432\u0435\u0442\u044b. \u0412 \u0431\u043e\u0440\u044c\u0431\u0435 \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u0432\u0441\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0445\u043e\u0440\u043e\u0448\u0438. &#8212; \u0423\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u043c\u0443, \u0432\u0435\u0434\u044c \u0432 \u0412\u0430\u0448\u0435\u0439 \u0441\u0435\u043c\u044c\u0435 \u0435\u0441\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0430\u043a\u0436\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0438 \u0437\u0430\u0431\u043e\u0442\u044b.<\/li>\n<li>\u041d\u0435 \u0441\u0442\u043e\u0438\u0442 \u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0432\u0441\u0435 \u0434\u043e\u043b\u0433\u0438 \u0438 \u0441\u0447\u0435\u0442\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e. \u0415\u0441\u043b\u0438 \u0412\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0432\u0441\u0435 \u0437\u0430 \u043d\u0435\u0433\u043e \u043f\u043b\u0430\u0442\u0438\u0442\u044c, \u0442\u043e \u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c. \u0415\u0441\u043b\u0438 \u0436\u0435 \u0412\u044b \u043d\u0435 \u0431\u0443\u0434\u0435\u0442\u0435 \u044d\u0442\u043e\u0433\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0438 \u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u0435\u043c\u0443, \u0447\u0442\u043e\u0431 \u043e\u043d \u0441\u0430\u043c \u0432\u0441\u0435 \u043f\u043b\u0430\u0442\u0438\u043b, \u0442\u043e \u044d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0435\u0433\u043e \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438.<\/li>\n<li>\u041f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u0441\u0435 \u043c\u0435\u0440\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0433\u0440\u0430\u0434\u0438\u0442\u044c \u0441\u0435\u0431\u044f \u043e\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0439 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d, \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u043f\u044c\u044f\u043d\u0435\u043d\u0438\u044f \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.<\/li>\n<\/ul>\n<p>\u0417\u0430\u0434\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441: <em>\u0412 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 72 \u0447\u0430\u0441\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0438 \u043f\u0440\u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u043f\u043b\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0412\u0430\u0448\u0443 \u043b\u0438\u0447\u043d\u0443\u044e \u043c\u0438\u0441\u0441\u0438\u044e \u043f\u043e\u043c\u043e\u0449\u0438 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0412 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0438\u0437 4 \u043f\u0443\u043d\u043a\u0442\u043e\u0432, \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u043e 3-7 \u0446\u0435\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0412\u044b \u0438 \u0412\u0430\u0448\u0430 \u0441\u0435\u043c\u044c\u044f \u0433\u043e\u0442\u043e\u0432\u044b \u0431\u0443\u0434\u0443\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c.<\/em><\/p>\n<p>\u0414\u0430\u043b\u0435\u0435 \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u044d\u0442\u0438 \u0446\u0435\u043b\u0438 \u0438 \u0440\u043e\u043b\u0438 \u043c\u0435\u0436\u0434\u0443 \u0432\u0441\u0435\u043c\u0438 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0441\u0435\u043c\u044c\u0438 \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0438\u0445 \u0441\u0442\u043e\u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0443\u044e \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e. \u042d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u0435\u0440\u0432\u044b\u043c \u043c\u043e\u0449\u043d\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u0432 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0412\u0430\u0448\u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0412\u0430\u043c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f: \u041f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u0440\u0