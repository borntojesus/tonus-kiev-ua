{"id":8042,"date":"2020-11-01T21:38:09","date_gmt":"2020-11-01T18:38:09","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?p=8042"},"modified":"2020-11-01T21:38:25","modified_gmt":"2020-11-01T18:38:25","slug":"istorija-moej-bolezni","status":"publish","type":"post","link":"https:\/\/tonus.kiev.ua\/istorija-moej-bolezni\/","title":{"rendered":"\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043c\u043e\u0435\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438: \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u044d\u0442\u0430\u043f\u043e\u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043e \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438"},"content":{"rendered":"<p><span style=\"color: #003366;\"><strong>\u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 27 \u043b\u0435\u0442<\/strong><\/span><br \/>\n\u041d\u0430\u0447\u0430\u043b\u043e \u043c\u043e\u0435\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043f\u0443\u0441\u0442\u0438\u043b\u043e \u0441\u0432\u043e\u0438 \u043a\u043e\u0440\u043d\u0438 \u0432 2006 \u0433\u043e\u0434\u0443. \u041d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u043c\u043d\u0435 \u0431\u044b\u043b\u043e 13 \u043b\u0435\u0442. \u0422\u0430\u043a \u0441\u043b\u043e\u0436\u0438\u043b\u043e\u0441\u044c , \u0447\u0442\u043e \u0440\u0435\u0431\u044f\u0442\u0430 \u0441 \u043c\u043e\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0431\u044b\u043b\u0438, \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043d\u0430 5 \u043b\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435. \u041e\u043d\u0438 \u0447\u0430\u0441\u0442\u043e \u043f\u0438\u043b\u0438 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c \u0438 \u0438\u043d\u043e\u0433\u0434\u0430 \u043a\u0443\u0440\u0438\u043b\u0438 \u043c\u0430\u0440\u0438\u0445\u0443\u0430\u043d\u0443. \u041f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e , \u0432 \u043c\u043e\u0435\u043c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0438, \u044d\u0442\u0438 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u044b\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u0437\u0440\u0435\u043b\u043e\u0441\u0442\u0438. \u0418 \u044f \u0440\u0435\u0448\u0438\u043b \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u043f\u0438\u0432\u043e. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u043e\u043d\u043e \u043c\u043d\u0435 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c, \u0441\u043a\u043e\u0440\u0435\u0435 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0435\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442. \u041a\u0430\u043a \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435, \u0441\u043f\u0443\u0441\u0442\u044f \u0433\u043e\u0434 \u044f \u0443\u0436\u0435 \u0441\u043b\u0430\u0431\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u043e\u0431\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0432 \u043d\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0431\u0435\u0437 \u043d\u0435\u0433\u043e.<\/p>\n<p>\u0412 15 \u043b\u0435\u0442 \u044f \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u043c\u0430\u0440\u0438\u0445\u0443\u0430\u043d\u0443, \u0431\u043e\u043b\u044c\u0448\u0435 \u0437\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e, \u043d\u0435\u0436\u0435\u043b\u0438 \u043f\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435. \u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0434\u0432\u043e\u044f\u043a\u0438\u043c\u0438: \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0431\u044b\u043b\u043e \u0441\u043c\u0435\u0448\u043d\u043e, \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 &#8212; \u0443\u0447\u0430\u0441\u0442\u0438\u043b\u043e\u0441\u044c \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u0435, \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0441\u0442\u0440\u0430\u0445\u0430,\u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u0443\u0445\u043e\u0441\u0442\u044c \u0432\u043e \u0440\u0442\u0443. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c \u043c\u043e\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0430\u043c\u0438. \u0421\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u044f \u043d\u0430\u0447\u0430\u043b \u0432\u0438\u0434\u0435\u0442\u044c \u0432 &#171;\u043f\u043b\u0430\u043d\u0435&#187; \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043f\u043e\u043c\u043e\u0447\u044c \u0443\u0439\u0442\u0438 \u043e\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0436\u0435\u043b\u0430\u0435\u043c\u044b\u0435 \u044d\u043c\u043e\u0446\u0438\u0438. \u041a\u0443\u0440\u0438\u043b \u043f\u043e \u043f\u0430\u0440\u0443 \u0440\u0430\u0437 \u043d\u0430 \u0434\u0435\u043d\u044c.<\/p>\n<blockquote><p><span style=\"font-size: 12pt;\">\u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 16 \u043b\u0435\u0442 \u043c\u043d\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c <a href=\"https:\/\/tonus.kiev.ua\/lechenie-ot-amfetamina\/\"><strong>\u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d<\/strong><\/a>, \u044f \u0443\u0436\u0435 \u0441\u043b\u044b\u0448\u0430\u043b \u043e\u0431 \u044d\u0442\u043e\u043c \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0435 \u0438 \u0434\u043e\u043b\u0433\u043e \u043d\u0435 \u0440\u0430\u0437\u0434\u0443\u043c\u044b\u0432\u0430\u043b. \u0422\u043e\u0433\u0434\u0430 \u044f \u0435\u0449\u0435 \u043d\u0435 \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u044f \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 <strong>\u0431\u0435\u0441\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c \u0435\u0433\u043e<\/strong>, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u043b\u044e\u0441\u044c \u0441 \u043b\u044e\u0434\u044c\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u043c\u0435\u044e\u0442 \u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u0438 <strong>\u0441\u0442\u0430\u043d\u0443 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c<\/strong>.<\/span><\/p><\/blockquote>\n<p>\u041d\u0435 \u0437\u043d\u0430\u043b \u044f \u0438 \u043e \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u0432\u0438\u0434\u0430 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u044f, \u0412\u0421\u0414, \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u044f, \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u043b\u0433\u043e \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0447\u0435\u043c &#8212; \u043b\u0438\u0431\u043e, \u043f\u0441\u0438\u0445\u043e\u0437. \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0441 \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u043e\u043c \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441 17 \u0434\u043e 26 \u043b\u0435\u0442, \u044f \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u043b \u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a : Lsd, Mdma, 2C-B, Dmt, 2-PC, 2-CI, \u043f\u0441\u0438\u043b\u043e\u0446\u0438\u0431\u0438\u043d\u043e\u0432\u044b\u0435 \u0433\u0440\u0438\u0431\u044b, \u0442\u0440\u0430\u043c\u0430\u0434\u043e\u043b, <a href=\"https:\/\/tonus.kiev.ua\/kodterpin\/\">\u043a\u043e\u0434\u0442\u0435\u0440\u043f\u0438\u043d<\/a>, <a href=\"https:\/\/tonus.kiev.ua\/narkotik-metadon\/\">\u043c\u0435\u0442\u0430\u0434\u043e\u043d<\/a> (\u0430\u043f\u0442\u0435\u0447\u043d\u044b\u0439 \u0438 \u0443\u043b\u0438\u0447\u043d\u044b\u0439), \u043f\u0435\u0440\u0432\u0438\u043d\u0442\u0438\u043d.<\/p>\n<p>\u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u0430 \u0438 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0435\u043c\u044b\u0445 \u043c\u043d\u043e\u044e \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u043a 23 \u0433\u043e\u0434\u0430\u043c \u043d\u0430\u0447\u0430\u043b\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0435\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0421\u043c\u0435\u043d\u0438\u043b\u0441\u044f \u043a\u0440\u0443\u0433 \u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435 \u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u0431\u0440\u0430\u0442\u044c \u0442\u0440\u0443\u0431\u043a\u0443, \u043d\u043e\u0432\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432 \u044f \u043d\u0435 \u0437\u0430\u0432\u043e\u0434\u0438\u043b, \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0442\u0430\u043b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0430 \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0439 \u043a\u0440\u0443\u0433 \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u0437 \u0442\u0430\u043a\u0438\u0445 \u0436\u0435 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u043e\u0432, \u043a\u0430\u043a \u0438 \u044f.<\/p>\n<p>\u0422\u044f\u0436\u0435\u043b\u043e \u0431\u044b\u043b\u043e \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044f \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434, \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0431\u0438\u0432\u0430\u043b\u043e \u0438\u0437 \u043a\u043e\u043b\u0435\u0438 , \u043a\u0430\u043a \u043c\u0435\u043d\u044f ,\u0442\u0430\u043a \u0438 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439. \u041f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0438\u0442\u044c \u0432 \u043a\u0430\u043a\u0443\u044e &#8212; \u043b\u0438\u0431\u043e \u0432\u044b\u0441\u0448\u0443\u044e \u0441\u0438\u043b\u0443. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e\u0441\u044c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f. \u0410\u0440\u0438\u0442\u043c\u0438\u044f , \u0412\u0421\u0414, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u0447\u0430\u0441\u0442\u044b\u0435 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u0442\u0430\u043a\u0438 \u0438 \u043c\u043d\u043e\u0433\u043e\u0435 \u0434\u0440\u0443\u0433\u043e\u0435.<\/p>\n<blockquote><p><span style=\"font-size: 12pt;\">\u0427\u0442\u043e \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044f \u0441\u0442\u0430\u043b \u043d\u0430 <strong>\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438<\/strong>, \u043d\u0430 <a href=\"https:\/\/tonus.kiev.ua\/buprenorfin-opasnost-priema\/\"><strong>\u0431\u0443\u043f\u0440\u0435\u043d\u043e\u0440\u0444\u0438\u043d<\/strong><\/a>, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u043f\u0441\u0438\u0445\u0438\u043a\u0443 \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432 \u0446\u0435\u043b\u043e\u043c, \u0432 \u0431\u043e\u043b\u0435\u0435-\u043c\u0435\u043d\u0435\u0435 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438. \u041d\u0435 \u043e\u0441\u043e\u0437\u043d\u0430\u0432\u0430\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u043e\u043f\u0430\u0434\u0430\u044e \u0435\u0449\u0435 \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443. \u0422\u0430\u043a \u044f \u0441\u0442\u0430\u043b <a href=\"https:\/\/tonus.kiev.ua\/lechenie-buprenorfinovoj-zavisimosti\/\"><strong>\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u043e\u0442 \u0431\u0443\u043f\u0440\u0435\u043d\u043e\u0440\u0444\u0438\u043d\u0430<\/strong><\/a>.<\/span><\/p><\/blockquote>\n<p>\u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043f\u043e \u043a\u0430\u043a\u0438\u043c &#8212; \u0442\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u044f \u043e\u0442\u043b\u0435\u0436\u0438\u0432\u0430\u043b\u0441\u044f \u0434\u043e\u043c\u0430, \u043d\u0435 \u0436\u0435\u043b\u0430\u044f \u0447\u0442\u043e-\u043b\u0438\u0431\u043e \u0434\u0435\u043b\u0430\u0442\u044c. \u0410 \u043f\u043e\u0442\u043e\u043c \u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u043c\u043e\u043c\u0435\u043d\u0442 \u044f \u043e\u0441\u043e\u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u0442\u0430\u043a \u0434\u0430\u043b\u044c\u0448\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u0441\u044f \u043d\u0435 \u043c\u043e\u0436\u0435\u0442. \u041f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c \u0438 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u043e \u043f\u043e\u043c\u043e\u0449\u0438. \u0422\u0430\u043a \u044f \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0432 <a href=\"https:\/\/tonus.kiev.ua\/o-nas\/\">\u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0446\u0435\u043d\u0442\u0440\u0435 \u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441<\/a>, \u0433\u0434\u0435 \u043c\u043d\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044e \u043c\u043e\u0435\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.<\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e? \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435? \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e <a href=\"tel:+380951046244\"><strong>095 104 62 44<\/strong><\/a> \u0438\u043b\u0438 <strong><a href=\"tel:+380984158464\">098 415 84 64<\/a><\/strong><\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 27 \u043b\u0435\u0442 \u041d\u0430\u0447\u0430\u043b\u043e \u043c\u043e\u0435\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043f\u0443\u0441\u0442\u0438\u043b\u043e \u0441\u0432\u043e\u0438 \u043a\u043e\u0440\u043d\u0438 \u0432 2006 \u0433\u043e\u0434\u0443. \u041d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u043c\u043d\u0435 \u0431\u044b\u043b\u043e 13 \u043b\u0435\u0442. \u0422\u0430\u043a \u0441\u043b\u043e\u0436\u0438\u043b\u043e\u0441\u044c , \u0447\u0442\u043e \u0440\u0435\u0431\u044f\u0442\u0430 \u0441 \u043c\u043e\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0431\u044b\u043b\u0438, \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043d\u0430 5 \u043b\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435. \u041e\u043d\u0438 \u0447\u0430\u0441\u0442\u043e \u043f\u0438\u043b\u0438 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c \u0438 \u0438\u043d\u043e\u0433\u0434\u0430 \u043a\u0443\u0440\u0438\u043b\u0438 \u043c\u0430\u0440\u0438\u0445\u0443\u0430\u043d\u0443. \u041f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e , \u0432 \u043c\u043e\u0435\u043c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0438, \u044d\u0442\u0438 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u044b\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u0437\u0440\u0435\u043b\u043e\u0441\u0442\u0438. \u0418 \u044f&#8230;<\/p>\n","protected":false},"author":1,"featured_media":8043,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":[],"categories":[1],"tags":[],"yst_prominent_words":[2092,2073,1569,2089,2090,2087,2094,982,777,2095,900,784,2088,1705,2091,1486,2093,225],"_links":{"self":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/posts\/8042"}],"collection":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/comments?post=8042"}],"version-history":[{"count":1,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/posts\/8042\/revisions"}],"predecessor-version":[{"id":8044,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/posts\/8042\/revisions\/8044"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/media\/8043"}],"wp:attachment":[{"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/media?parent=8042"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/categories?post=8042"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/tags?post=8042"},{"taxonomy":"yst_prominent_words","embeddable":true,"href":"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/yst_prominent_words?post=8042"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}