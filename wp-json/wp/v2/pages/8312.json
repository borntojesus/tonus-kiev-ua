idth: 858px) 100vw, 858px\" title=\"\u041e \u0446\u0435\u043d\u0442\u0440\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438 \u0438 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u0430 &quot;\u0422\u043e\u043d\u0443\u0441 \u041f\u043b\u044e\u0441&quot;\" \/><\/div><\/div><div class=\"w-separator size_medium\"><\/div><div class=\"wpb_text_column\"><div class=\"wpb_wrapper\"><p style=\"text-align: center;\">\u0417\u0430\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0443\u044e \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044e \u043a \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0443 <strong>\u0410\u043b\u0444\u0435\u0440\u043e\u0432\u043e\u0439 \u0415\u043b\u0435\u043d\u0435<\/strong>, \u043f\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c: \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438, \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f \u043d\u0430\u0440\u043a\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445, \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u0430 \u0438 \u0438\u0433\u0440\u043e\u043c\u0430\u043d\u0438\u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430\u043c:<\/p>\n<p style=\"text-align: center;\"><a href=\"tel:+380951046244\"><strong><span style=\"font-size: 14pt;\">095 104 62 44<\/span><\/strong><\/a> \u0438\u043b\u0438 <a href=\"tel:+380984158464\"><strong><span style=\"font-size: 14pt;\">098 415 84 64<\/span><\/strong><\/a><\/p>\n<div><\/div>\n<\/div><\/div><div class=\"w-separator size_medium\"><\/div><div class=\"wpb_text_column\"><div class=\"wpb_wrapper\"><p style=\"text-align: center;\">\u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0432\u043e\u043f\u0440\u043e\u0441:<\/p>\n<div><\/div>\n<\/div><\/div><div class=\"w-separator size_small\"><\/div><form class=\"w-form  layout_ver for_cform us_form_1\" autocomplete=\"off\" action=\"https:\/\/tonus.kiev.ua\/wp-json\/wp\/v2\/pages\/8312\" method=\"post\"><div class=\"w-form-h\"><div class=\"w-form-row for_text with_icon\">\n\t\t<div class=\"w-form-row-field\">\n\t\t\t\t<i class=\"far fa-user\"><\/i>\t\t<input aria-label=\"\u0418\u043c\u044f\" type=\"text\" name=\"us_form_1_text_1\" value placeholder=\"\u0418\u043c\u044f\"\/>\n\t\t\t<\/div>\n\t\t<div class=\"w-form-row-state\">\u0417\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u043e\u043b\u0435<\/div>\n<\/div>\n<div class=\"w-form-row for_email with_icon\">\n\t\t<div class=\"w-form-row-field\">\n\t\t\t\t<i class=\"far fa-at\"><\/i>\t\t<input aria-label=\"Email\" type=\"email\" name=\"us_form_1_email_1\" value placeholder=\"Email\"\/>\n\t\t\t<\/div>\n\t\t<div class=\"w-form-row-state\">\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0441 email.<\/div>\n<\/div>\n<div class=\"w-form-row for_textarea\">\n\t\t<div class=\"w-form-row-field\">\n\t\t\t\t\t\t<textarea aria-label=\"\u0422\u0435\u043a\u0441\u0442\" name=\"us_form_1_textarea_1\" placeholder=\"\u0422\u0435\u043a\u0441\u0442\"><\/textarea>\n\t\t\t<\/div>\n\t\t<div class=\"w-form-row-state\">\u0417\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u043e\u043b\u0435<\/div>\n<\/div>\n<input type=\"hidden\" name=\"action\" value=\"us_ajax_cform\" \/>\n<input type=\"hidden\" name=\"post_id\" value=\"0\" \/>\n<input type=\"hidden\" name=\"form_index\" value=\"1\" \/>\n<div class=\"w-form-row for_submit align_none\">\n\t<div class=\"w-form-row-field\">\n\t\t<button class=\"w-btn  us-btn-style_1\" aria-label=\"\u041e\u0442\u043f\u0440\u0430\u0432\u