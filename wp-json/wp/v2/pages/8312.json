u0435\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u042e\u0440\u0438\u044f \u0411\u0443\u0433\u0430\u044f&#187;.<\/span><\/li>\n<li><span style=\"color: #53bd9b;\">\u0421\u043e\u0446\u0438\u043e\u043b\u043e\u0433. \u041d\u041f\u0423 \u0438\u043c. \u041c.\u041f. \u0414\u0440\u0430\u0433\u043e\u043c\u0430\u043d\u043e\u0432\u0430<\/span><\/li>\n<\/ul>\n<p><strong>\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438:<\/strong><\/p>\n<ul style=\"list-style-type: square;\">\n<li><span style=\"color: #003366;\">&#171;\u0428\u043a\u043e\u043b\u0430 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b&#187; <\/span><\/li>\n<li><span style=\"color: #003366;\">\u041a\u0438\u0435\u0432\u043e-\u041c\u0430\u0433\u0435\u043b\u044f\u043d\u0441\u043a\u0430\u044f \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044f.<\/span><\/li>\n<li><span style=\"color: #003366;\">\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u043e\u043c<\/span><\/li>\n<li><span style=\"color: #003366;\">&#171;\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0439 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u041c\u0435\u043d\u0435\u0434\u0436\u043c\u0435\u043d\u0442\u0430&#187; &#8212; \u041a\u0438\u0435\u0432.<\/span><\/li>\n<li><span style=\"color: #003366;\">\u041f\u0440\u043e\u043f\u0435\u0434\u0435\u0432\u0442\u0438\u043a\u0430 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0438<\/span><\/li>\n<li><span style=\"color: #003366;\">\u0421\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u044b\u0439 \u0410\u0420\u0422-\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044f\u043c\u0438.<\/span><\/li>\n<\/ul>\n<p>\u041e \u0441\u0435\u0431\u0435: <span style=\"color: #003366;\"><strong>\u0441\u0442\u0430\u0436 \u0440\u0430\u0431\u043e\u0442\u044b 18 \u043b\u0435\u0442<\/strong><\/span><\/p>\n<blockquote>\n<p>&#171;\u041c\u043e\u044f \u0440\u0430\u0431\u043e\u0442\u0430 &#8212; \u044d\u0442\u043e \u043c\u043e\u044f \u043c\u0435\u0447\u0442\u0430, \u0432\u043e\u043f\u043b\u043e\u0449\u0435\u043d\u043d\u0430\u044f \u0432 \u0436\u0438\u0437\u043d\u044c!<br \/>\n\u041c\u043e\u0451 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0435!&#187;<\/p>\n<\/blockquote>\n<p>\u0412\u043e\u0442 \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u043b\u0435\u0442 \u044f &#8212; \u041f\u0440\u043e\u0432\u043e\u0434\u043d\u0438\u043a \u0432 \u043c\u0438\u0440 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0439 \u0442\u0440\u0435\u0437\u0432\u043e\u0441\u0442\u0438. \u0420\u0430\u0431\u043e\u0442\u0430\u044e \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0438 \u0438\u0445 \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c.<\/p>\n<p>\u0412 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445, \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445 \u0438 \u0433\u0440\u0443\u043f\u043f\u043e\u0432\u044b\u0445 \u0441\u0435\u0441\u0441\u0438\u044f\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e \u043c\u0435\u0442\u043e\u0434\u044b \u041a\u041f\u0422, \u0422\u0410, \u041f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0410\u0420\u0422-\u0442\u0435\u0440\u0430\u043f\u0438\u0438.<\/p>\n<p>\u0412 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0435\u0441\u0442\u044c \u0434\u0432\u0430 \u043f\u0443\u0442\u0438 &#8212; \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435. \u042f, \u043a\u0430\u043a \u0432\u044b \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442\u0435 \u0437\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0443.<br \/>\n\u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u043c\u043e\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u043e\u0434\u0445\u043e\u0434: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435 \u043d\u0430\u0432\u044b\u043a\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0451 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435.<\/p>\n<p><strong>\u041c\u043e\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f:<\/strong><br \/>\n\u0423\u0432\u0435\u0440\u0435\u043d\u0430, \u0447\u0442\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043c\u044b \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c \u043e\u0434\u0438\u043d \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u043a &#8212; \u041a\u0410\u041a \u041b\u042e\u0411\u0418\u0422\u042c! \u041b\u044e\u0431\u0438\u0442\u044c \u0441\u0435\u0431\u044f, \u0441\u0432\u043e\u0438\u0445 \u0431\u043b\u0438\u0437\u043a\u0438\u0445, \u0441\u0432\u043e\u044e \u0441\u0435\u043c\u044c\u044e, \u0440\u0430\u0431\u043e\u0442\u0443, \u0441\u0442\u0440\u0430\u043d\u0443.<br \/>\n\u0418 \u0432\u0441\u0451 \u0432\u043e\u043a\u0440\u0443\u0433 \u043e\u0431\u0443\u0447\u0430\u0435\u0442 \u043d\u0430\u0441 \u044d\u0442\u043e\u043c\u0443.<\/p>\n<p>\u0412\u044b\u0445\u043e\u0434\u044f \u0438\u0437 \u0434\u043e\u043c\u043e\u0432, \u043c\u043d\u043e\u0433\u0438\u0435 \u0438\u0434\u0443\u0442 \u0432\u043e\u0435\u0432\u0430\u0442\u044c. \u0421 \u0441\u043e\u0431\u043e\u0439, \u0441 \u043c\u0438\u0440\u043e\u043c, \u0441 \u0411\u043e\u0433\u043e\u043c&#8230; \u0422\u0440\u0443\u0434\u0435\u043d \u0436\u0435 \u0442\u0432\u043e\u0439 \u043f\u0443\u0442\u044c, \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0435\u0441\u043b\u0438 \u0442\u044b \u0438\u0434\u0435\u0448\u044c \u0432\u043e\u0435\u0432\u0430\u0442\u044c, \u0430 \u043d\u0435 \u043b\u044e\u0431\u0438\u0442\u044c!<\/p>\n<p><strong>\u0425\u043e\u0431\u0431\u0438:<\/strong><br \/>\n<em>\u041b\u044e\u0431\u043b\u044e \u0441\u043e\u0431\u0430\u043a, \u0440\u0438\u0441\u043e\u0432\u0430\u0442\u044c, \u0442\u0430\u043d\u0446\u0435\u0432\u0430\u0442\u044c \u0438 \u043e\u0431\u0443\u0447\u0430\u0442\u044c\u0441\u044f.<\/em><\/p>\n<p>&#171;\u042d\u0442\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e!&#187; &#8212; \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u041f\u0440\u0438\u0447\u0438\u043d\u0430.<br \/>\n\u00ab\u042d\u0442\u043e \u0431\u0435\u0437\u0440\u0430\u0441\u0441\u0443\u0434\u0441\u0442\u0432\u043e!\u00bb &#8212; \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u041e\u043f\u044b\u0442.<br \/>\n\u00ab\u042d\u0442\u043e \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e!\u00bb &#8212; \u043e\u0442\u0440\u0435\u0437\u0430\u043b\u0430 \u0413\u043e\u0440\u0434\u043e\u0441\u0442\u044c.<br \/>\n\u00ab\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439&#8230;\u00bb &#8212; \u0448\u0435\u043f\u043d\u0443\u043b\u0430 \u041c\u0435\u0447\u0442\u0430.<\/p>\n<p>\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u0441\u0435\u0431\u0435 \u0411\u042b\u0422\u042c!!!! \u042d\u0442\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0440\u0435\u0441\u0443\u0440\u0441\u043d\u043e\u0435 \