{"id":7775,"date":"2020-02-17T02:15:33","date_gmt":"2020-02-16T23:15:33","guid":{"rendered":"https:\/\/tonus.kiev.ua\/?page_id=7775"},"modified":"2020-02-17T02:18:53","modified_gmt":"2020-02-16T23:18:53","slug":"pomoshh-sozavisimym","status":"publish","type":"page","link":"https:\/\/tonus.kiev.ua\/pomoshh-sozavisimym\/","title":{"rendered":"\u041f\u043e\u043c\u043e\u0449\u044c \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e"},"content":{"rendered":"<section class=\"l-section wpb_row height_medium\"><div class=\"l-section-h i-cf\"><div class=\"g-cols via_flex valign_top type_default\"><div class=\"vc_col-sm-12 wpb_column vc_column_container\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\"><div class=\"g-cols wpb_row via_flex valign_top type_default\"><div class=\"vc_col-sm-12 wpb_column vc_column_container\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\"><div class=\"wpb_text_column\"><div class=\"wpb_wrapper\"><blockquote>\n<p>\u0421\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u2013 \u044d\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u041e\u043d \u0441\u0432\u044f\u0437\u0430\u043d \u0432 \u0441\u0432\u043e\u0438\u0445 \u043c\u044b\u0441\u043b\u044f\u0445, \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445 \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u0445. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0441 \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u044b\u043c: \u0447\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f, \u043f\u0440\u0438\u0434\u0451\u0442 \u043b\u0438 \u0434\u043e\u043c\u043e\u0439, \u043d\u0435 \u0443\u043a\u0440\u0430\u043b \u043b\u0438, \u043d\u0435 \u043f\u043e\u043f\u0430\u043b \u043b\u0438 \u0432 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443. \u042d\u0442\u0438 \u043c\u044b\u0441\u043b\u0438 \u043b\u0438\u0448\u0430\u044e\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c, \u043c\u044b\u0441\u043b\u0438\u0442\u044c, \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e \u0436\u0438\u0442\u044c.<\/p>\n<\/blockquote>\n<p>\u041e\u0431\u0449\u0430\u044f \u0447\u0435\u0440\u0442\u0430 \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u043b\u044e\u0434\u0435\u0439 \u2013 \u044d\u0442\u043e \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0438\u0437 \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u0439, \u0442\u0430\u043a\u0438\u0435 \u043b\u044e\u0434\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b, \u0447\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043d\u0438 \u0437\u043d\u0430\u044e\u0442, \u043a\u0430\u043a \u043d\u0430\u0434\u043e \u0432\u0435\u0441\u0442\u0438 \u0441\u0435\u0431\u044f \u0432 \u0441\u0435\u043c\u044c\u0435, \u0438 \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u044e\u0442 \u0447\u0443\u0436\u0443\u044e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u0441\u0432\u043e\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u044e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0432 \u0434\u043e\u043c\u0435. \u0423\u0433\u0440\u043e\u0437\u044b, \u0441\u043e\u0432\u0435\u0442\u044b, \u043f\u0440\u0438\u043d\u0443\u0436\u0434\u0435\u043d\u0438\u0435, \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u2013 \u0432\u0441\u0435 \u044d\u0442\u043e \u0440\u044b\u0447\u0430\u0433\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u0430 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e\u0449\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0441\u0443\u0433\u0443\u0431\u043b\u044f\u044e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445.<\/p>\n<p>\u041f\u043e\u043f\u044b\u0442\u043a\u0438 \u0441\u043f\u0430\u0441\u0442\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438: \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u0430, \u0438\u0433\u0440\u043e\u043c\u0430\u043d\u0438\u0438, \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u0438. \u0412 \u044d\u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u043c\u044b\u0439, \u0432\u0437\u044f\u0432 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u043e, \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0435\u0442 \u043e\u0431\u0440\u0430\u0449\u0430\u0442\u044c \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0432\u043e\u0438 \u043d\u0443\u0436\u0434\u044b: \u043e\u0442\u0434\u044b\u0445, \u0435\u0434\u0443, \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434, \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435.<\/p>\n<p>\u0421\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0435 \u043b\u044e\u0434\u0438 \u043b\u0438\u0448\u044c \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043a\u0430\u0436\u0443\u0442\u0441\u044f \u0441\u0432\u0435\u0440\u0445\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438, \u043e\u0434\u043d\u0430\u043a\u043e \u0438\u0445 \u0431\u0435\u0437\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e \u043a \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0438\u0437-\u0437\u0430 \u0433\u0438\u043f\u0435\u0440\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c, \u043b\u0438\u0448\u0430\u0435\u0442 \u0438\u0445 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0438\u043b\u0438 \u0441\u0443\u043f\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438.<\/p>\n<p>\u0421\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u043c \u0440\u0438\u0441\u043a\u0430 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430 \u0443 \u0432\u044b\u0437\u0434\u043e\u0440\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0433\u043e.<br \/>\n\u0414\u043b\u044f \u043e\u0431\u0449\u0435\u0439 \u043f\u043e\u0431\u0435\u0434\u044b \u043d\u0430\u0434 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e, \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0441\u0442\u043e\u0438\u0442 \u043f\u0440\u043e\u0439\u0442\u0438 \u0438 \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e.<\/p>\n<h3>\u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0432\u0435\u0442\u043e\u0432, \u043a\u0430\u043a \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u043d\u0435 \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0441\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.<\/h3>\n<p>\u041a\u0430\u043a \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c?<\/p>\n<ol>\n<li>\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 &#8212; \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e. \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0441\u043b\u0443\u0448\u0430\u0442\u044c, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u043a \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0443.<\/li>\n<li>\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 &#8212; \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441\u043e \u0441\u043b\u043e\u0432: &#187; \u0422\u044b \u043c\u043d\u0435 \u0434\u043e\u0440\u043e\u0433,\u043d\u043e&#8230;&#187;,\u0438 \u0442.\u0434.<\/li>\n<li>\u0412 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0442\u0440\u0451\u0445 &#171;\u043d\u0435\u0442&#187;. \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043e\u0447\u0435\u0442 \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u0441\u0432\u043e\u0435\u0433\u043e, \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c,\u043d\u043e \u0412\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e.<\/li>\n<li>\u0411\u043e\u043b\u044c\u0448\u0435 \u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445. \u0413\u043e\u0432\u043e\u0440\u0438\u0442\u0435 \u0447\u0442\u043e \u0412\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,\u043d\u0435 \u043e\u0431\u0432\u0438\u043d\u044f\u0439\u0442\u0435. &#187; \u041c\u043d\u0435 \u0431\u043e\u043b\u044c\u043d\u043e&#8230;&#187; , &#187; \u043c\u043d\u0435 \u043d\u0435 \u043f\u0440\u0438\u044f\u0442\u043d\u043e&#8230;&#187;.<\/li>\n<li>\u041a\u043e\u0430\u043b\u0438\u0446\u0438\u044f. \u041c\u043e\u0436\u043d\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u0430 \u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: &#187; \u042f \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u044e \u043d\u0435 \u043e\u0434\u043d\u0430&#8230;&#187;, &#171;\u044d\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043c\u044b \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0432\u043c\u0435\u0441\u0442\u0435&#187;. \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e \u043e\u043d \u043e\u0434\u0438\u043d \u0432 \u0441\u0432\u043e\u0435\u0439 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0438.<\/li>\n<\/ol>\n<p style=\"text-align: center;\"><em>\u041e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0432\u0448\u0438\u0441\u044c \u0441 \u0434\u0430\u043d\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439, \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0443\u0437\u043d\u0430\u0432 \u0432 \u043d\u0435\u0439 \u0441\u0432\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u0432\u0435\u0440\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043f\u043e\u043c\u043e\u0449\u044c. \u0412\u0435\u0434\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u0432 \u0441 \u0441\u0435\u0431\u044f, \u0412\u044b \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043c\u043e\u0447\u044c \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0412\u0430\u043c \u043b\u044e\u0434\u044f\u043c.<\/em><\/p>\n<h3 style=\"text-align: center;\">\u0415\u0441\u043b\u0438 \u0432\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0432 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0432\u0430\u0448\u0438 \u0440\u043e\u0434\u043d\u044b\u0435, \u0431\u043b\u0438\u0437\u043a\u0438\u0435, \u0437\u0432\u043e\u043d\u0438\u0442\u0435! \u041d\u0435 \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430, \u0441\u043f\u0430\u0441\u0438\u0442\u0435 \u0436\u0438\u0437\u043d\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443: <a href=\"tel:+380951046244\">095 104 62 44<\/a> \u0438\u043b\u0438 <a href=\"tel:+380984158464\">098 415 84 64<\/a><\/h3>\n<\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/section>\n","protected":false},"excerpt":{"rendered":"\u0421\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u2013 \u044d\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430\u0